{% extends 'base.html.twig' %}

{% block title %}Liste des Banques{% endblock %}

{% block body %}

  <div class="flex-grow-1 container-p-y container-fluid">
    <div class="card">
      <div class="card-header">
        <h5 class="card-title mb-0">🏦 Liste des Banques</h5>
        <div class="d-flex justify-content-end align-items-center row pt-4 gap-md-0 g-6">
          <div class="col-md-4 d-flex justify-content-end gap-2">
            <button class="btn btn-success" data-bs-toggle="offcanvas" data-bs-target="#offcanvasAddBanque">
              <i class="icon-base bx bx-plus me-2"></i>Ajouter une banque
            </button>
            <a href="#" class="btn btn-danger" target="_blank">
              <i class="bx bxs-file-pdf me-2"></i>Exporter PDF
            </a>
          </div>
        </div>
      </div>
      <div class="card-body p-1">
        <table class="datatables-banques table border-top">
          <thead>
            <tr>
              <th>N°</th>
              <th>Nom</th>
              <th>Compte</th>
              <th>SWIFT</th>
              <th>Ville</th>
              <th>Pays</th>
              <th>Téléphone</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {% for banque in banques %}
              <tr>
                <td>{{ banque.SEQBANQUE }}</td>
                <td>{{ banque.LIBBANQUE }}</td>
                <td>{{ banque.CPTBANQUE }}</td>
                <td>{{ banque.SWFBANQUE }}</td>
                <td>{{ banque.VILBANQUE.libville ?? '' }}</td>
                <td>{{ banque.PAYBANQUE.libpays ?? '' }}</td>
                <td>{{ banque.TELBANQUE }}</td>
                <td>
                  <div class="dropdown">
                    <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                      <i class="icon-base bx bx-dots-vertical-rounded"></i>
                    </button>
                    <div class="dropdown-menu">
                      <a class="dropdown-item" href="{{ path('app_banque_index', {'edit': banque.SEQBANQUE}) }}">
                        <i class="icon-base bx bx-edit-alt me-1"></i> Consulter | Modifier
                      </a>
                      {{ include('banque/_delete_form.html.twig', {'banque': banque}) }}
                    </div>
                  </div>
                </td>
              </tr>
            {% else %}
              <tr>
                <td colspan="8" class="text-center">Aucune banque trouvée</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Offcanvas pour ajouter une banque -->
  <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasAddBanque" aria-labelledby="offcanvasAddBanqueLabel">
    <div class="offcanvas-header border-bottom">
      <h5 id="offcanvasAddBanqueLabel" class="offcanvas-title">Ajouter une banque</h5>
      <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body mx-0 flex-grow-0 p-6 h-100">
      {{ include('banque/_form.html.twig', {
        form: addForm,
        button_label: 'Enregistrer'
      }) }}
    </div>
  </div>

  <!-- Offcanvas pour modifier une banque -->
  {% if editForm is defined and editForm %}
    <div class="offcanvas offcanvas-end show" tabindex="-1" id="offcanvasEditBanque" style="visibility: visible;" aria-labelledby="offcanvasEditBanqueLabel">
      <div class="offcanvas-header border-bottom">
        <h5 id="offcanvasEditBanqueLabel" class="offcanvas-title">Modifier la banque</h5>
        <a href="{{ path('app_banque_index') }}" class="btn-close text-reset" aria-label="Close"></a>
      </div>
      <div class="offcanvas-body mx-0 flex-grow-0 p-6 h-100">
        {{ include('banque/_form.html.twig', {
          form: editForm,
          button_label: 'Mettre à jour'
        }) }}
      </div>
    </div>
  {% endif %}
{% endblock %}