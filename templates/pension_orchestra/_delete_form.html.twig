<form method="post"
      action="{{ path('app_pension_orchestra_delete', {'seqPensionOrchestra': pension_orchestra.seqPensionOrchestra}) }}"
      class="delete-form">
  <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ pension_orchestra.seqPensionOrchestra) }}">

  <button type="button"
          class="dropdown-item text-danger border-0 bg-transparent w-100 text-start delete-btn"
          data-entity-type="ce pension orchestra"
          data-confirm-message="Êtes-vous sûr de vouloir supprimer ce pension orchestra ? Cette action est irréversible."
          data-success-message="Le pension orchestra a été supprimé avec succès">
    <i class="icon-base bx bx-trash me-1"></i> Supprimer
  </button>
</form>
