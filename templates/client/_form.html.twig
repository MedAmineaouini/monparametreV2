{#{% extends '@!EasyAdmin/crud/form_theme.html.twig' %}#}

{% block _client_form_widget %}
    {{ form_start(form, {'attr': {'class': 'form-horizontal', 'style': 'font-size: 14px'}}) }}
    <div class="box-body d-flex gap-4">
        <!-- Left Column - Main Form -->
        <div class="col-md-8 card card-body shadow-sm">
            <!-- Form Sections -->
            <div class="mb-2">
                <div class="card-header bg-light">
                    <h6 class="mb-0">Informations générales</h6>
                </div>
                <div class="row g-3">
                    <div class="col-md-4">
                        {{ form_row(form.seqclt, {
                            'label': 'Code',
                            'row_attr': {'class': 'mb-3'},
                            'attr': {'class': 'form-select form-select-sm'}
                        }) }}
                    </div>
                    <div class="col-md-4">
                        {{ form_row(form.seqcltpackdb, {
                            'label': 'Seq. Pack DB',
                            'row_attr': {'class': 'mb-3'},
                            'attr': {'class': 'form-control form-control-sm'}
                        }) }}
                    </div>
                    <div class="col-md-4">
                        {{ form_row(form.refpackdb, {
                            'label': 'Groupement agence',
                            'row_attr': {'class': 'mb-3'},
                            'attr': {'class': 'form-control form-control-sm'}
                        }) }}
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        {{ form_row(form.nomclt, {
                            'label': 'Nom & Prénom',
                            'row_attr': {'class': 'mb-3'},
                            'attr': {'class': 'form-control form-control-sm text-uppercase'}
                        }) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.nomreseau, {
                            'label': 'Réseau',
                            'row_attr': {'class': 'mb-3'},
                            'attr': {'class': 'form-control form-control-sm'}
                        }) }}
                    </div>
                </div>
            </div>

            <!-- Address Section -->
            <div class="mb-2">
                <div class="card-header bg-light">
                    <h6 class="mb-0">Adresses</h6>
                </div>
                <div class="row g-3">
                    <div class="col-12">
                        {{ form_row(form.adresse, {
                            'label': 'Adresse (1)',
                            'row_attr': {'class': 'mb-3'},
                            'attr': {'class': 'form-control form-control-sm text-uppercase'}
                        }) }}
                    </div>
                    <div class="col-12">
                        {{ form_row(form.adresse2, {
                            'label': 'Adresse (2)',
                            'row_attr': {'class': 'mb-3'},
                            'attr': {'class': 'form-control form-control-sm text-uppercase'}
                        }) }}
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        {{ form_row(form.cp, {
                            'label': 'Code Postal',
                            'row_attr': {'class': 'mb-3'},
                            'attr': {'class': 'form-control form-control-sm text-uppercase'}
                        }) }}
                    </div>
                    <div class="col-md-4">
                        {{ form_row(form.VILLE, {
                            'label': 'Ville',
                            'row_attr': {'class': 'mb-3'},
                            'attr': {'class': 'form-select form-select-sm'}
                        }) }}
                    </div>
                    <div class="col-md-4">
                        {{ form_row(form.PAYS, {
                            'label': 'Pays',
                            'row_attr': {'class': 'mb-3'},
                            'attr': {'class': 'form-select form-select-sm'}
                        }) }}
                    </div>
                </div>
            </div>

            <!-- Contact Section -->
            <div class="mb-2">
                <div class="card-header bg-light">
                    <h6 class="mb-0">Coordonnées</h6>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        {{ form_row(form.tel1, {
                            'label': 'Téléphone (1)',
                            'row_attr': {'class': 'mb-3'},
                            'attr': {'class': 'form-control form-control-sm'}
                        }) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.tel2, {
                            'label': 'Téléphone (2)',
                            'row_attr': {'class': 'mb-3'},
                            'attr': {'class': 'form-control form-control-sm'}
                        }) }}
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        {{ form_row(form.tel3, {
                            'label': 'Téléphone portable',
                            'row_attr': {'class': 'mb-3'},
                            'attr': {'class': 'form-control form-control-sm'}
                        }) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.fax, {
                            'label': 'Fax',
                            'row_attr': {'class': 'mb-3'},
                            'attr': {'class': 'form-control form-control-sm'}
                        }) }}
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-5">
                        {{ form_row(form.email, {
                            'label': 'Email principal',
                            'row_attr': {'class': 'mb-3'},
                            'attr': {'class': 'form-control form-control-sm'}
                        }) }}
                    </div>
                    <div class="col-md-5">
                        {{ form_row(form.compta, {
                            'label': 'Email compta',
                            'row_attr': {'class': 'mb-3'},
                            'attr': {'class': 'form-control form-control-sm'}
                        }) }}
                    </div>
                    <div class="col-md-2">
                        {{ form_row(form.codeAgence, {
                            'label': 'Code agence',
                            'row_attr': {'class': 'mb-3'},
                            'attr': {'class': 'form-control form-control-sm'}
                        }) }}
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        {{ form_row(form.convoc, {
                            'label': 'Email Convocation',
                            'row_attr': {'class': 'mb-3'},
                            'attr': {'class': 'form-control form-control-sm'}
                        }) }}
                    </div>
                    <div class="col-6">
                        {{ form_row(form.resa, {
                            'label': 'Email résa',
                            'row_attr': {'class': 'mb-3'},
                            'attr': {'class': 'form-control form-control-sm'}
                        }) }}
                    </div>
                </div>
            </div>

            <!-- Professional Section -->
            <div class="mb-2">
                <div class="card-header bg-light">
                    <h6 class="mb-0">Informations professionnelles</h6>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        {{ form_row(form.patron, {
                            'label': 'Premier responsable',
                            'row_attr': {'class': 'mb-3'},
                            'attr': {'class': 'form-control form-control-sm text-uppercase'}
                        }) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.groupeclient, {
                            'label': 'Groupe client',
                            'row_attr': {'class': 'mb-3'},
                            'attr': {'class': 'form-control form-control-sm text-uppercase'}
                        }) }}
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        {{ form_row(form.contact, {
                            'label': 'Contact tourisme',
                            'row_attr': {'class': 'mb-3'},
                            'attr': {'class': 'form-control form-control-sm text-uppercase'}
                        }) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.analytique, {
                            'label': 'S. analytique',
                            'row_attr': {'class': 'mb-3'},
                            'attr': {'class': 'form-select form-select-sm'}
                        }) }}
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        {{ form_row(form.ccompta, {
                            'label': 'Code comptable',
                            'row_attr': {'class': 'mb-3'},
                            'attr': {'class': 'form-control form-control-sm text-uppercase'}
                        }) }}
                    </div>
                    <div class="col-md-4">
                        {{ form_row(form.principal, {
                            'label': 'Ag. principale',
                            'row_attr': {'class': 'mb-3'},
                            'attr': {'class': 'form-control form-control-sm text-uppercase'}
                        }) }}
                    </div>
                    <div class="col-md-4">
                        {{ form_row(form.SEQCOMMERCIAL, {
                            'label': 'Commercial',
                            'row_attr': {'class': 'mb-3'},
                            'attr': {'class': 'form-select form-select-sm'}
                        }) }}
                    </div>
                </div>
            </div>

            <!-- Payment Section -->
            <div class="mb-2 bg-light p-3 rounded">
                <div class="card-header bg-light">
                    <h6 class="mb-0">Règlement</h6>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        {{ form_row(form.libtyperegle, {
                            'label': 'Type règlement',
                            'row_attr': {'class': 'mb-3'},
                            'attr': {'class': 'form-select form-select-sm'}
                        }) }}
                    </div>
                    <div class="col-md-6 d-flex align-items-center">
                        <div class="form-check form-switch">
                            {{ form_widget(form.comttc, {'attr': {'class': 'form-check-input'}}) }}
                            <label class="form-check-label" for="{{ form.comttc.vars.id }}">Commission sur TTC</label>
                        </div>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        {{ form_row(form.libtypeclt, {
                            'label': 'Modalité règlement',
                            'row_attr': {'class': 'mb-3'},
                            'attr': {'class': 'form-control form-control-sm'}
                        }) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.seqcomm, {
                            'label': 'Commission',
                            'row_attr': {'class': 'mb-3'},
                            'attr': {'class': 'form-select form-select-sm'}
                        }) }}
                    </div>
                </div>
            </div>

            <!-- Observations -->
            <div class="mb-2">
                {{ form_row(form.obs, {
                    'label': 'Observations',
                    'row_attr': {'class': 'mb-3'},
                    'attr': {'class': 'form-control form-control-sm', 'rows': 3}
                }) }}
            </div>
        </div>

        <!-- Right Column - Sidebar -->
        <div class="col-md-4">
            <!-- Balance Due -->
            <div class="card mb-3 shadow-sm">
                <div class="card-body">
                    <div class="card-header bg-light">
                        <h6 class="mb-0">Reste à payer global:</h6>
                    </div>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text">Reste à payer</span>
                        <input type="text" class="form-control text-end fw-bold" value="0.00" readonly>
                    </div>
                </div>
            </div>

            <!-- Payment Warning -->
            <div class="alert alert-warning py-2 mb-32 d-none" id="paymentWarning">
                <i class="fas fa-exclamation-triangle me-2"></i> Paiement avant départ requis
            </div>

            <!-- Options Card -->
            <div class="card mb-3 shadow-sm">
                <div class="card-header bg-light">
                    <h6 class="mb-0">Options</h6>
                </div>
                <div class="card-body">
                    {% for field, label in {
                        libre: 'Main libre',
                        confirmation: 'Avec confirmation',
                        paiement: 'Paiement avant départ',
                        refunique: 'Ref dossier uniquement',
                        litige: 'Litige',
                        carnetvoyage: 'Carnet de voyage',
                        pointcom: 'Client.com',
                        basculeAutoReglement: 'Bascule Auto Réglement'
                    } %}
                        <div class="form-check form-switch mb-2">
                            {{ form_widget(attribute(form, field), {
                                'attr': {
                                    'class': 'form-check-input',
                                    'role': 'switch'
                                }
                            }) }}
                            <label class="form-check-label" for="{{ attribute(form, field).vars.id }}">{{ label }}</label>
                        </div>
                    {% endfor %}

                    <div class="form-check form-switch mb-2">
                        <input type="checkbox" class="form-check-input" id="com_annul">
                        <label class="form-check-label" for="com_annul">Fact.Annul.avec Com</label>
                    </div>

                    <div class="form-check form-switch mb-2">
                        <input type="checkbox" class="form-check-input" id="tva_invisible">
                        <label class="form-check-label" for="tva_invisible">Ne pas afficher la TVA</label>
                    </div>
                </div>
            </div>

            <!-- Technical Card -->
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h6 class="mb-0">Paramètres techniques</h6>
                </div>
                <div class="card-body">
                    <!-- Amadeus -->
                    <div class="mb-3">
                        <label for="{{ form.codeamadeus.vars.id }}" class="form-label small fw-bold text-primary">Code Amadeus</label>
                        {{ form_widget(form.codeamadeus, {
                            'attr': {'class': 'form-control form-control-sm'}
                        }) }}
                    </div>

                    <!-- BTOB Credentials -->
                    <div class="mb-3">
                        <label for="{{ form.loginbtob.vars.id }}" class="form-label small fw-bold">Identifiants BTOB</label>
                        <div class="input-group input-group-sm mb-2">
                            <span class="input-group-text">Login</span>
                            {{ form_widget(form.loginbtob, {
                                'attr': {'class': 'form-control'}
                            }) }}
                        </div>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text">Mot de passe</span>
                            {{ form_widget(form.mdpbtob, {
                                'attr': {'class': 'form-control'}
                            }) }}
                        </div>
                    </div>

                    <!-- Language -->
                    <div class="mb-3">
                        <label for="{{ form.docLangue.vars.id }}" class="form-label small fw-bold text-primary">Langue carnet</label>
                        {{ form_widget(form.docLangue, {
                            'attr': {'class': 'form-select form-select-sm'}
                        }) }}
                    </div>

                    <!-- Dates -->
                    <div class="mb-3">
                        <label for="{{ form.datesaisie.vars.id }}" class="form-label small fw-bold">Date création</label>
                        {{ form_widget(form.datesaisie, {
                            'attr': {'class': 'form-control form-control-sm'}
                        }) }}
                    </div>

                    <!-- Archive -->
                    <div class="form-check form-switch">
                        {{ form_widget(form.archiver, {'attr': {'class': 'form-check-input'}}) }}
                        <label class="form-check-label text-danger fw-bold" for="{{ form.archiver.vars.id }}">Archiver ce client</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Form Footer -->
    <div class="form-footer mt-4 d-flex justify-content-between">
        <a href="{{ path('app_client_index') }}" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i> Annuler
        </a>
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save me-2"></i> Enregistrer
        </button>
    </div>
    {{ form_end(form) }}

    <style>
        .form-label {
            font-weight: 500;
            margin-bottom: 0.25rem;
        }
        .card-header {
            padding: 0.5rem 1rem;
        }
        .form-control-sm, .form-select-sm {
            font-size: 0.875rem;
        }
        .text-uppercase {
            text-transform: uppercase;
        }
    </style>

    <script>
        // Show payment warning when checkbox is checked
        document.getElementById('{{ form.paiement.vars.id }}').addEventListener('change', function() {
            document.getElementById('paymentWarning').classList.toggle('d-none', !this.checked);
        });
    </script>
{% endblock %}