{% extends 'base.html.twig' %}

{% block title %}Liste des clients{% endblock %}

{% block body %}
<div class="flex-grow-1 container-p-y container-fluid">
    <div class="card">
        <div class="card-header text-white d-block d-sm-flex justify-content-between align-items-center">
            <h5 class="mb-0 ">📋 Liste des Clients</h5>
            <div class="d-flex  col-md-2">
                    <a href="{{ path('app_client_new') }}" class="btn btn-success">
                        <i class="icon-base bx bx-plus me-2"></i> Ajouter un Client
                    </a>
            </div>
        </div>

        <div class="card-body p-3">

            <form method="get" id="filterForm" class="mb-4">
                <div class="d-flex flex-wrap gap-3 align-items-end">

                    <div class="form-group">
                        <label for="seqclt" class="form-label">Code client :</label>
                        <input type="text" name="seqclt" id="seqclt" class="form-control" value="{{ searchParams.seqclt ?? '' }}">
                    </div>

                    <div class="form-group">
                        <label for="nomclt" class="form-label">Nom client :</label>
                        <input type="text" name="nomclt" id="nomclt" class="form-control" value="{{ searchParams.nomclt ?? '' }}">
                    </div>

                    <div class="form-group">
                        <label for="nomreseau" class="form-label">Nom réseau :</label>
                        <select name="nomreseau" id="nomreseau" class="form-select">
                            <option value="">-- Tous --</option>
                            {% for reseau in reseauOptions %}
                                <option value="{{ reseau }}" {{ reseau == searchParams.nomreseau ? 'selected' : '' }}>
                                    {{ reseau }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="grcommission" class="form-label">Gr.commission :</label>
                        <select name="nomreseau" id="nomreseau" class="form-select">
                            <option value="">-- Tous --</option>
                            {% for reseau in reseauOptions %}
                                <option value="{{ reseau }}" {{ reseau == searchParams.nomreseau ? 'selected' : '' }}>
                                    {{ reseau }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div>
                        <button type="submit" class="btn btn-primary">Filtrer</button>
                        <a href="{{ path('app_client_index') }}" class="btn btn-secondary ms-2">Réinitialiser</a>
                    </div>

                </div>
            </form>

            {% if clients is not empty %}
                <div class="table-responsive">
                    <table class="table table-hover table-striped table-bordered mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Numéro</th>
                                <th>Nom</th>
                                <th>Réseau</th>
                                <th>Commission</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for client in clients %}
                                <tr>
                                    <td>{{ client.seqclt }}</td>
                                    <td>{{ client.nomclt }}</td>
                                    <td>{{ client.nomreseau }}</td>
                                    <td>{{ client.commission.nomcomm ?? '' }}</td>
                                    <td>
                                       <a href="{{ path('app_client_edit', {'numclt': client.numclt}) }}">Modifier</a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <p class="text-center text-muted py-4">Aucun client trouvé.</p>
            {% endif %}
        </div>
    </div>

    <script>
        const form = document.getElementById('filterForm');
        const inputs = form.querySelectorAll('input[type="text"], select');

        inputs.forEach(input => {
            input.addEventListener('input', () => {
                if (form.submitTimeout) clearTimeout(form.submitTimeout);
                form.submitTimeout = setTimeout(() => {
                    form.submit();
                }, 300);
            });
        });
    </script>
{% endblock %}
