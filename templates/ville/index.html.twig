{% extends 'base2.html.twig' %}

{% block title %}Ville index{% endblock %}

{% block body %}
    <div class="card shadow rounded-3 border-0">
        <div class="card-header text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">📋  Listes des Villes</h5>
            <a href="{{ path('app_ville_new') }}" class="btn btn-success btn-sm">
                <i class="bx bx-plus"></i> Nouvelle ville
            </a>
        </div>
        <hr>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped align-middle small">
                    <thead>
                    <tr>
                        <th>Seqville</th>
                        <th>Codeville</th>
                        <th>Aero</th>
                        <th>Libville</th>
                        <th>Codeiata</th>
                        <th>Seq_zone</th>
                        <th>Iataaero</th>
                        <th>Seqvilleparent</th>
                        <th>Taxe_b2b</th>
                        <th>actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for ville in villes %}
                        <tr>
                            <td>{{ ville.seqville }}</td>
                            <td>{{ ville.codeville }}</td>
                            <td>{{ ville.aero }}</td>
                            <td>{{ ville.libville }}</td>
                            <td>{{ ville.codeiata }}</td>
                            <td>{{ ville.seqZone }}</td>
                            <td>{{ ville.iataaero }}</td>
                            <td>{{ ville.seqvilleparent }}</td>
                            <td>{{ ville.taxeB2b }}</td>
                            <td>
                                <a href="{{ path('app_ville_show', {'seqville': ville.seqville}) }}">show</a>
                                <a href="{{ path('app_ville_edit', {'seqville': ville.seqville}) }}">edit</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="10" style="text-align: center" class="text-center text-muted">aucun enregistrement trouvé.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
