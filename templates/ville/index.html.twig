{% extends 'base2.html.twig' %}

{% block title %}RFT | Liste des Villes {% endblock %}

{% block body %}
    <div class="card shadow rounded-3 border-0">
        <div class="card-header text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">📋 Listes des Villes</h5>

            <div class="d-flex gap-2">
                <a href="{{ path('app_ville_new') }}" class="btn btn-success btn-sm">
                    <i class="bx bx-plus"></i> Nouvelle ville
                </a>

                <a href="{{ path('app_ville_export_pdf') }}" class="btn btn-danger btn-sm" target="_blank">
                    <i class="bx bxs-file-pdf"></i> Exporter en PDF
                </a>
            </div>
        </div>

        <hr>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped align-middle small">
                    <thead>
                    <tr>
                        <th>N°</th>
                        <th>Code ville</th>
                        <th>Libville</th>
{#                        <th>Code iata</th>#}
                        <th>Pays</th>
                        <th>Souspays</th>
                        <th>actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for ville in villes %}
                        <tr>
                            <td>{{ ville.seqville }}</td>
                            <td>{{ ville.codeville }}</td>
                            <td>{{ ville.libville }}</td>
{#                            <td>{{ ville.codeiata }}</td>#}
                            <td>{{ ville.pays.libpays }}</td>
                            <td>{{ ville.souspays.libsouspays }}</td>
                            <td>
                                <div class="dropdown">
                                    <button type="button" class="btn p-0 dropdown-toggle hide-arrow"
                                            data-bs-toggle="dropdown">
                                        <i class="icon-base bx bx-dots-vertical-rounded"></i>
                                    </button>
                                    <div class="dropdown-menu">
                                        <a class="dropdown-item"
                                           href="{{ path('app_ville_edit', {'seqville': ville.seqville}) }}">
                                            <i class="icon-base bx bx-edit-alt me-1"></i> Consulter / Modifier
                                        </a>

                                        {{ include('ville/_delete_form.html.twig') }}
                                    </div>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="10" style="text-align: center" class="text-center text-muted">aucun enregistrement trouvé.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
