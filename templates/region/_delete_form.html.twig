<form method="post"
      action="{{ path('app_region_delete', {'seqregion': region.seqregion}) }}"
      class="delete-form">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ region.seqregion) }}">
    <button type="button"
            class="dropdown-item text-danger border-0 bg-transparent w-100 text-start delete-btn"
            data-entity-type="cette région"
            data-confirm-message="Êtes-vous sûr de vouloir supprimer cette région ? Cette action est irréversible."
            data-success-message="La région a été supprimée avec succès">
        <i class="icon-base bx bx-trash me-1"></i> Supprimer
    </button>
</form>
