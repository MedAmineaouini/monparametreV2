<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{{ title }}</title>
    <style>
        body { font-family: Arial, sans-serif; }
        h1 { color: #333; text-align: center; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th { background-color: #f2f2f2; text-align: left; padding: 8px; }
        td { padding: 8px; border-bottom: 1px solid #ddd; }
        .text-center { text-align: center; }
        .badge { padding: 3px 6px; border-radius: 3px; font-size: 12px; }
        .bg-label-success { background-color: #d1fae5; color: #065f46; }
        .bg-label-secondary { background-color: #e5e7eb; color: #374151; }
        .bg-label-danger { background-color: #fee2e2; color: #b91c1c; }
        .bg-label-primary { background-color: #dbeafe; color: #1e40af; }
    </style>
</head>
<body>
<h1>{{ title }}</h1>
<p>Généré le : {{ "now"|date("d/m/Y H:i") }}</p>

<table>
    <thead>
    <tr>
        <th>#</th>
        <th>Libellé</th>
        <th>N° compte</th>
        <th>Comptabilisable</th>
        <th>Journal</th>
        <th>Sens</th>
    </tr>
    </thead>
    <tbody>
    {% for typeregle in typeregles %}
        <tr>
            <td class="text-center">{{ typeregle.seqTyperegle }}</td>
            <td>{{ typeregle.libTyperegle }}</td>
            <td>{{ typeregle.contrepartie }}</td>
            <td class="text-center">
                {% if typeregle.comptabilisable %}
                    <span class="badge bg-label-success">Oui</span>
                {% else %}
                    <span class="badge bg-label-secondary">Non</span>
                {% endif %}
            </td>
            <td>{{ typeregle.journal }}</td>
            <td class="text-center">
                        <span class="badge bg-label-{{ typeregle.sens == 'Débit' ? 'danger' : 'primary' }}">
                            {{ typeregle.sens }}
                        </span>
            </td>
        </tr>
    {% else %}
        <tr>
            <td colspan="6" class="text-center">Aucun type de règle enregistré</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
</body>
</html>