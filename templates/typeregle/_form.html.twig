<div class="card-body p-1" style="font-size: 12px">
    {{ form_start(form, {'attr': {'class': 'browser-default-validation'}}) }}

    <div class="row g-3 mb-4 align-items-center">
        {# Champ Libellé #}
        <div class="col-md-12">
            {{ form_label(form.libtyperegle, null, {'label_attr': {'class': 'form-label'}}) }}
            <strong class="text-danger">*</strong>
            {{ form_widget(form.libtyperegle) }}
        </div>

        {# Champ Compte #}
        <div class="col-md-12">
            {{ form_label(form.contrepartie, null, {'label_attr': {'class': 'form-label'}}) }}
            <strong class="text-danger">*</strong>
            {{ form_widget(form.contrepartie) }}
        </div>

        {# Champ Comptabilisable #}
        <div class="col-md-12">
            {{ form_label(form.comptabilisable, null, {'label_attr': {'class': 'form-label'}}) }}
            <strong class="text-danger">*</strong>
            {{ form_widget(form.comptabilisable) }}
        </div>

        {# Champ Journal #}
        <div class="col-md-12">
            {{ form_label(form.journal, null, {'label_attr': {'class': 'form-label'}}) }}
            <strong class="text-danger">*</strong>
            {{ form_widget(form.journal) }}
        </div>

        {# Champ Sens #}
        <div class="col-md-12">
            {{ form_label(form.sens, null, {'label_attr': {'class': 'form-label'}}) }}
            <strong class="text-danger">*</strong>
            {{ form_widget(form.sens) }}
        </div>
    </div>

    {# Boutons de soumission #}
    <div class="pt-3 border-top text-end">
        <button type="submit" class="btn btn-primary w-100 mb-2">
            <i class="bx bx-save me-2"></i>{{ button_label|default('Enregistrer') }}
        </button>
        {% if form.vars.data.seqtyperegle %}
            <a href="{{ path('app_typeregle_index') }}" class="btn btn-outline-danger w-100 px-4">
                <i class="bx bx-x me-2"></i>Annuler
            </a>
        {% else %}
            <button type="button" class="btn btn-outline-danger w-100 px-4" data-bs-dismiss="offcanvas">
                <i class="bx bx-x me-2"></i>Annuler
            </button>
        {% endif %}
    </div>

    {{ form_end(form) }}
</div>