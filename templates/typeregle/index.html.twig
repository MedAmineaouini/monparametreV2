{% extends 'base.html.twig' %}

{% block title %}RFT | Liste des reglement{% endblock %}

{% block body %}

    <div class="card shadow rounded-3 border-0">

        <div class="card-header  text-white">
            <div class="row align-items-center">
                <div class="col-12 col-md-8 mb-2 mb-md-0">
                    <h5 class="mb-0 text-center text-md-start">📋 Types de règlements</h5>
                </div>
                <div class="col-9 col-md-4 d-flex flex-column flex-md-row justify-content-md-end gap-2">
                    <a class="btn btn-success w-100 w-md-auto" data-bs-toggle="offcanvas" data-bs-target="#offcanvasAddTyperegle">
                        <i class="bx bx-plus me-2"></i>Ajouter un type de réglement
                    </a>
                    <a href="{{ path('app_typeregle_export_pdf') }}" class="btn btn-danger  w-100 w-md-auto">
                        <i class="bx bxs-file-pdf me-2"></i>Export PDF
                    </a>
                </div>
            </div>
        </div>
        <div class="card-body p-1">
            <div class="table-responsive">
                <table class="table table-hover table-striped table-bordered mb-1">
                    <thead>
                    <th class="text-center" width="60">#</th>
                    <th>Libellé</th>
                    <th>N° compte</th>
                    <th class="text-center">Comptabilisable</th>
                    <th>Journal</th>
                    <th class="text-center">Sens</th>
                    <th class="text-center" width="100">Actions</th>
                    </thead>
                    <tbody>
                    {% for typeregle in typeregles %}
                        <tr>
                            <td class="text-center">{{ typeregle.seqTyperegle }}</td>
                            <td>{{ typeregle.libTyperegle }}</td>
                            <td>{{ typeregle.contrepartie }}</td>
                            <td class="text-center">
                                {% if typeregle.comptabilisable %}
                                    <span class="">Oui</span>
                                {% else %}
                                    <span class="">Non</span>
                                {% endif %}
                            </td>
                            <td>{{ typeregle.journal }}</td>
                            <td class="text-center">
                                    <span class="">
                                        {{ typeregle.sens }}
                                    </span>
                            </td>
                            <td class="text-center">
                                <div class="dropdown">
                                    <button type="button"
                                            class="btn p-0 dropdown-toggle hide-arrow"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false"
                                            aria-label="Actions">
                                        <i class="bx bx-dots-vertical-rounded"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <a class="dropdown-item"
                                               href="{{ path('app_typeregle_index', {'edit': typeregle.seqTyperegle}) }}"
                                               aria-label="Modifier">
                                                <i class="bx bx-edit-alt me-2"></i>Consulter | Modifier
                                            </a>
                                        </li>
                                        <li>
                                            {{ include('typeregle/_delete_form.html.twig', {
                                                'typeregle': typeregle,
                                                'btn_class': 'dropdown-item'
                                            }) }}
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                Aucun Types de règlements enregistré
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Offcanvas -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasAddTyperegle" aria-labelledby="offcanvasAddTyperegleLabel"   data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="offcanvas-header border-bottom">
            <h5 id="offcanvasAddTyperegleLabel" class="offcanvas-title">Ajouter un Type de règle</h5>
            <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Fermer"></button>
        </div>
        <div class="offcanvas-body mx-0 flex-grow-0 p-6 h-100">
            {{ include('typeregle/_form.html.twig', {
                form: form,
                button_label: 'Enregistrer'
            }) }}
        </div>
    </div>
    <!-- Offcanvas pour modification -->
    {% if editForm is defined and editForm %}
        <div class="offcanvas offcanvas-end show" tabindex="-1" id="offcanvasEditTyperegle" data-bs-backdrop="static" data-bs-keyboard="false" style="visibility: visible;" aria-labelledby="offcanvasEditTyperegleLabel">
            <div class="offcanvas-header border-bottom">
                <h5 id="offcanvasEditTyperegleLabel" class="offcanvas-title">Modifier le Type de règle</h5>
                <a href="{{ path('app_typeregle_index') }}" class="btn-close text-reset" aria-label="Fermer"></a>
            </div>
            <div class="offcanvas-body mx-0 flex-grow-0 p-6 h-100">
                {{ form_start(editForm, {
                    'action': path('app_typeregle_index', {'edit': typeregleToEdit.seqTyperegle}),
                    'attr': {'id': 'edit-form'}
                }) }}
                {{ form_widget(editForm) }}
                <hr>
                {#                <button type="submit" class="btn btn-primary">Enregistrer</button>#}
                <button type="submit" class="btn btn-primary w-100 mb-2">
                    <i class="bx bx-save me-2"></i>{{ button_label|default('Enregistrer') }}
                </button>
                {#                <button type="button" class="btn btn-outline-danger w-100 px-4" data-bs-dismiss="offcanvas">#}
                {#                    <i class="bx bx-x me-2"></i>Annuler#}
                {#                </button>#}
                <a href="{{ path('app_typeregle_index') }}" class="btn btn-outline-danger w-100 px-4">
                    <i class="bx bx-x me-2"></i>Annuler
                </a>
                {{ form_end(editForm) }}
            </div>
        </div>

        <script>
            // Fermer l'offcanvas d'ajout si l'offcanvas d'édition est ouvert
            const addOffcanvas = document.getElementById('offcanvasAddTyperegle');
            if (addOffcanvas) {
                const bsAddOffcanvas = bootstrap.Offcanvas.getInstance(addOffcanvas);
                if (bsAddOffcanvas) {
                    bsAddOffcanvas.hide();
                }
            }
        </script>
    {% endif %}
    {#    <div class="mt-3 text-end">#}
    {#        <a href="{{ path('app_typeregle_new') }}" class="btn btn-outline-primary">Créer via une nouvelle page</a>#}
    {#    </div>#}
{% endblock %}
