<form method="post"
      action="{{  path('app_typeregle_delete', {'seqtyperegle': typeregle.seqtyperegle}) }}"
      class="delete-form">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ typeregle.seqtyperegle) }}">
    <button type="button"
            class="dropdown-item text-danger border-0 bg-transparent w-100 text-start delete-btn"
            data-entity-type="cet réglement"
            data-confirm-message="Êtes-vous sûr de vouloir supprimer ce pays ? Cette action est irréversible."
            data-success-message="Le pays a été supprimé avec succès">
        <i class="icon-base bx bx-trash me-1"></i> Supprimer
    </button>
</form>