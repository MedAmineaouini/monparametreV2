{% extends 'base.html.twig' %}

{% block title %}Gestion des types clients{% endblock %}

{% block body %}
    <div class="flex-grow-1 container-p-y container-fluid">
        <div class="card shadow rounded-3 border-0">
            <div class="card-header text-white">
                <div class="row align-items-center">
                    <div class="col-12 col-md-10 mb-2 mb-md-0">
                        <h5 class="mb-0 text-center text-md-start">📋 Types clients</h5>
                    </div>
                    <div class="col-9 col-md-2 d-flex flex-column flex-md-row justify-content-md-end gap-2">
                        <button class="btn btn-success w-100 w-md-auto" data-bs-toggle="offcanvas" data-bs-target="#offcanvasAddTypeClt">
                            <i class="bx bx-plus me-2"></i>Ajouter un type client
                        </button>
                    </div>
                </div>
            </div>

            <div class="card-body p-1 table-responsive" style="font-size: 12px;">
                <div class="table-responsive">
                    <table class="table table-hover table-striped table-bordered mb-1">
                        <thead>
                        <tr>
                            <th class="text-center" width="60">#</th>
                            <th>Libellé</th>
                            <th>Départ</th>
                            <th>Jour fixe</th>
                            <th>Mois plus</th>
                            <th>Réservation</th>
                            <th>Date fixe</th>
                            <th>Échéancement</th>
                            <th class="text-center" width="100">Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for type_clt in type_clts %}
                            <tr>
                                <td class="text-center">{{ type_clt.seqtypeclt }}</td>
                                <td>{{ type_clt.libtypeclt }}</td>
                                <td>{{ type_clt.depart }}</td>
                                <td>{{ type_clt.jourFixe }}</td>
                                <td>{{ type_clt.moisPlus }}</td>
                                <td>{{ type_clt.reservation }}</td>
                                <td>{{ type_clt.dateFixe }}</td>
                                <td>{{ type_clt.echeancement }}</td>
                                <td class="text-center">
                                    <div class="dropdown">
                                        <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Actions">
                                            <i class="bx bx-dots-vertical-rounded"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <a class="dropdown-item" href="{{ path('app_type_clt_index', {'edit': type_clt.seqtypeclt}) }}">
                                                    <i class="bx bx-edit-alt me-2"></i>Consulter | Modifier
                                                </a>
                                            </li>
                                            <li>
                                                {{ include('type_clt/_delete_form.html.twig', {
                                                    type_clt: type_clt,
                                                    btn_class: 'dropdown-item'
                                                }) }}
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="9" class="text-center py-4 text-muted">Aucun type client trouvé</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    {# Offcanvas Ajout #}
    <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasAddTypeClt"
         aria-labelledby="offcanvasAddTypeCltLabel" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="offcanvas-header border-bottom">
            <h5 id="offcanvasAddTypeCltLabel" class="offcanvas-title">Ajouter un type client</h5>
            <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Fermer"></button>
        </div>
        <div class="offcanvas-body mx-0 flex-grow-0 p-6 h-100">
            {{ include('type_clt/_form.html.twig', {
                form: addForm,
                button_label: 'Enregistrer'
            }) }}
        </div>
    </div>

    {# Offcanvas Édition #}
    {% if editForm is defined and editForm %}
        <div class="offcanvas offcanvas-end show" tabindex="-1" id="offcanvasEditTypeClt"
             data-bs-backdrop="static" data-bs-keyboard="false"
             style="visibility: visible;" aria-labelledby="offcanvasEditTypeCltLabel">
            <div class="offcanvas-header border-bottom">
                <h5 id="offcanvasEditTypeCltLabel" class="offcanvas-title">Modifier le type client</h5>
                <a href="{{ path('app_type_clt_index') }}" class="btn-close text-reset" aria-label="Fermer"></a>
            </div>
            <div class="offcanvas-body mx-0 flex-grow-0 p-6 h-100">
                {{ include('type_clt/_form.html.twig', {
                    form: editForm,
                    button_label: 'Enregistrer'
                }) }}
            </div>
        </div>

        <script>
            // Ferme l'offcanvas "ajouter" si l'édition est active
            const addOffcanvas = document.getElementById('offcanvasAddTypeClt');
            if (addOffcanvas) {
                const bsAddOffcanvas = bootstrap.Offcanvas.getInstance(addOffcanvas);
                if (bsAddOffcanvas) {
                    bsAddOffcanvas.hide();
                }
            }
        </script>
    {% endif %}
{% endblock %}