<form method="post"
      action="{{ path('app_type_clt_delete', {'seqtypeclt': type_clt.seqtypeclt}) }}"
      class="delete-form">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ type_clt.seqtypeclt) }}">
    <button type="button"
            class="dropdown-item text-danger border-0 bg-transparent w-100 text-start delete-btn"
            data-entity-type="ce type client"
            data-confirm-message="Êtes-vous sûr de vouloir supprimer ce type client ? Cette action est irréversible."
            data-success-message="Le type client a été supprimé avec succès">
        <i class="icon-base bx bx-trash me-1"></i> Supprimer
    </button>
</form>