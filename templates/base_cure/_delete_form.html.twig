<form method="post"
      action="{{ path('app_base_cure_delete', {'seqcure': base_cure.seqcure}) }}"
      class="delete-form">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ base_cure.seqcure) }}">
    <button type="button"
            class="dropdown-item text-danger border-0 bg-transparent w-100 text-start delete-btn"
            data-entity-type="cette cure"
            data-confirm-message="Êtes-vous sûr de vouloir supprimer cette cure ? Cette action est irréversible."
            data-success-message="La cure a été supprimée avec succès.">
        <i class="icon-base bx bx-trash me-1"></i> Supprimer
    </button>
</form>
