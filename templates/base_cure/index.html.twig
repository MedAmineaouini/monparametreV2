{% extends 'base.html.twig' %}

{% block title %}Liste des Bases de Cures{% endblock %}

{% block body %}
    <div class="flex-grow-1 container-p-y container-fluid">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">🧾 Liste des Bases de Cures</h5>
                <div class="d-flex justify-content-end align-items-center row pt-4 gap-md-0 g-6">
                    <div class="col-md-4 d-flex justify-content-end gap-2">
                        <button class="btn btn-success" data-bs-toggle="offcanvas" data-bs-target="#offcanvasAddBaseCure">
                            <i class="icon-base bx bx-plus me-2"></i>Ajouter une base de cure
                        </button>
                        <a href="{{ path('app_base_cure_export_pdf') }}" class="btn btn-danger" target="_blank">
                            <i class="bx bxs-file-pdf me-2"></i>Exporter PDF
                        </a>
                    </div>
                </div>
            </div>
            <div class="card-body p-1">
                <table class="datatables-bases-cures table border-top">
                    <thead>
                    <tr>
                        <th>Code</th>
                        <th>Libellé</th>
                        <th>Archivé</th>
                        <th>Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for base_cure in base_cures %}
                        <tr>
                            <td>{{ base_cure.codelibcure }}</td>
                            <td>{{ base_cure.libelleCure ?? 'N/A' }}</td>
                            <td>
                                {% if base_cure.archiver %}
                                    <span class="badge bg-success">Oui</span>
                                {% else %}
                                    <span class="badge bg-danger">Non</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="dropdown">
                                    <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                                        <i class="icon-base bx bx-dots-vertical-rounded"></i>
                                    </button>
                                    <div class="dropdown-menu">
                                        <a class="dropdown-item" href="{{ path('app_base_cure_index', {'edit': base_cure.seqcure}) }}">
                                            <i class="icon-base bx bx-edit-alt me-1"></i> Consulter | Modifier
                                        </a>
                                        {{ include('base_cure/_delete_form.html.twig', {'base_cure': base_cure}) }}
                                    </div>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center">Aucune base de cure trouvée</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Offcanvas pour ajouter une base de cure -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasAddBaseCure" aria-labelledby="offcanvasAddBaseCureLabel">
        <div class="offcanvas-header border-bottom">
            <h5 id="offcanvasAddBaseCureLabel" class="offcanvas-title">Ajouter une base de cure</h5>
            <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body mx-0 flex-grow-0 p-6 h-100">
            {{ include('base_cure/_form.html.twig', {
                form: form,
                button_label: 'Enregistrer'
            }) }}
        </div>
    </div>

    <!-- Offcanvas pour modifier une base de cure -->
    {% if editForm is defined and editForm %}
        <div class="offcanvas offcanvas-end show" tabindex="-1" id="offcanvasEditBaseCure" style="visibility: visible;" aria-labelledby="offcanvasEditBaseCureLabel">
            <div class="offcanvas-header border-bottom">
                <h5 id="offcanvasEditBaseCureLabel" class="offcanvas-title">Modifier la base de cure</h5>
                <a href="{{ path('app_base_cure_index') }}" class="btn-close text-reset" aria-label="Close"></a>
            </div>
            <div class="offcanvas-body mx-0 flex-grow-0 p-6 h-100">
                {{ include('base_cure/_form.html.twig', {
                    form: editForm,
                    button_label: 'Enregistrer'
                }) }}
            </div>
        </div>
    {% endif %}
{% endblock %}