{% extends 'base.html.twig' %}

{% block title %}BaseCure{% endblock %}

{% block body %}
    <h1>BaseCure</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Codelibcure</th>
                <td>{{ base_cure.codelibcure }}</td>
            </tr>
            <tr>
                <th>Seqcure</th>
                <td>{{ base_cure.seqcure }}</td>
            </tr>
            <tr>
                <th>Seq</th>
                <td>{{ base_cure.seq }}</td>
            </tr>
            <tr>
                <th>LibelleCure</th>
                <td>{{ base_cure.libelleCure }}</td>
            </tr>
            <tr>
                <th>Typecure</th>
                <td>{{ base_cure.typecure }}</td>
            </tr>
            <tr>
                <th>Ancien</th>
                <td>{{ base_cure.ancien }}</td>
            </tr>
            <tr>
                <th>Archiver</th>
                <td>{{ base_cure.archiver ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Seqtypecure</th>
                <td>{{ base_cure.seqtypecure }}</td>
            </tr>
            <tr>
                <th>Libtypecure</th>
                <td>{{ base_cure.libtypecure }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_base_cure_index') }}">back to list</a>

    <a href="{{ path('app_base_cure_edit', {'codelibcure': base_cure.codelibcure}) }}">edit</a>

    {{ include('base_cure/_delete_form.html.twig') }}
{% endblock %}
