<form method="post"
      action="{{ path('app_sous_reseau_delete', {'seqsousreseau': sous_reseau.seqsousreseau}) }}"
      class="delete-form">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ sous_reseau.seqsousreseau) }}">
    <button type="button"
            class="dropdown-item text-danger border-0 bg-transparent w-100 text-start delete-btn"
            data-entity-type="ce sous-réseau"
            data-confirm-message="Êtes-vous sûr de vouloir supprimer ce sous-réseau ? Cette action est irréversible."
            data-success-message="Le sous-réseau a été supprimé avec succès">
        <i class="icon-base bx bx-trash me-1"></i> Supprimer
    </button>
</form>