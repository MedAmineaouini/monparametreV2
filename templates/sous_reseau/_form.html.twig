<div class="card-body p-1" style="font-size: 12px">
    {{ form_start(form, {'attr': {'class': 'browser-default-validation'}}) }}

    <div class="row g-3 mb-4">
        {# Champ nomsousreseau #}
        <div class="col-md-12">
            {{ form_label(form.nomsousreseau, null, {
                'label_attr': {
                    'class': 'form-label fw-semibold required'
                },
                'label': 'Nom du sous-réseau'
            }) }}
            {{ form_widget(form.nomsousreseau, {
                'attr': {
                    'class': 'form-control',
                    'placeholder': 'Entrez le nom du sous-réseau',
                    'required': 'required'
                }
            }) }}
            {{ form_errors(form.nomsousreseau) }}
        </div>
    </div>

    {# Ajoutez ici les autres champs de votre entité SousReseau #}
    {# Exemple avec un champ fictif 'description' #}
    {#
    <div class="row g-3 mb-4">
        <div class="col-md-12">
            {{ form_label(form.description, null, {
                'label_attr': {'class': 'form-label fw-semibold'},
                'label': 'Description'
            }) }}
            {{ form_widget(form.description, {
                'attr': {
                    'class': 'form-control',
                    'placeholder': 'Description du sous-réseau',
                    'rows': 3
                }
            }) }}
            {{ form_errors(form.description) }}
        </div>
    </div>
    #}

    <div class="pt-3 border-top text-end">
        <button type="submit" class="btn btn-primary w-100 mb-2">
            <i class="bx bx-save me-2"></i>{{ button_label|default('Enregistrer') }}
        </button>

        {% if form.vars.data.seqsousreseau is defined and form.vars.data.seqsousreseau %}
            <a href="{{ path('app_sous_reseau_index') }}" class="btn btn-outline-danger w-100 px-4">
                <i class="bx bx-x me-2"></i>Annuler
            </a>
        {% else %}
            <button type="button" class="btn btn-outline-danger w-100 px-4" data-bs-dismiss="offcanvas">
                <i class="bx bx-x me-2"></i>Annuler
            </button>
        {% endif %}
    </div>

    {{ form_end(form) }}
</div>