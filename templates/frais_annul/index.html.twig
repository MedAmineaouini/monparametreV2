{% extends 'base2.html.twig' %}

{% block title %}Liste des frais d'annulation{% endblock %}

{% block body %}
<div class="container-xxl flex-grow-1 container-p-y">
  <div class="card">
    <div class="card-header border-bottom">
      <h5 class="card-title mb-0">📋 Liste des frais d'annulation</h5>
      <div class="d-flex justify-content-end align-items-center row pt-4 gap-md-0 g-6">
        <div class="col-md-4 d-flex justify-content-end">
          <button class="btn btn-success" data-bs-toggle="offcanvas" data-bs-target="#offcanvasAddFraisAnnul">
            <i class="icon-base bx bx-plus me-2"></i>Ajouter un frais
          </button>
        </div>
      </div>
    </div>

    <div class="card-datatable">
      <table class="table table-striped table-hover border-top">
        <thead>
          <tr>
            <th>#</th>
            <th>Jour 1</th>
            <th>Jour 2</th>
            <th>Facteur</th>
            <th>Type</th>
            <th>Libellé</th>
            <th>Barème</th>
            <th>Montant min</th>
            <th>À appliquer</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {% for frais in frais_annuls %}
            <tr>
              <td>{{ frais.seqannul }}</td>
              <td>{{ frais.jour1 }}</td>
              <td>{{ frais.jour2 }}</td>
              <td>{{ frais.facteur }}</td>
              <td>{{ frais.typeannul == 0 ? 'Taux' : 'Valeur' }}</td>
              <td>{{ frais.libelle }}</td>
              <td>{{ frais.bareme }}</td>
              <td>{{ frais.montantmini }}</td>
              <td>{{ frais.applicable == 0 ? 'Par personne' : 'Par dossier' }}</td>
              <td>
                <div class="dropdown">
                  <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                    <i class="icon-base bx bx-dots-vertical-rounded"></i>
                  </button>
                  <div class="dropdown-menu">
                    <a class="dropdown-item" href="{{ path('app_frais_annul_index', {'edit': frais.seqannul}) }}">
                    <i class="icon-base bx bx-edit-alt me-1"></i> Modifier
                    </a>
                    {{ include('frais_annul/_delete_form.html.twig', { frais_annul: frais }) }}
                  </div>
                </div>
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="10" class="text-center">Aucun frais trouvé</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Offcanvas pour ajouter un frais -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasAddFraisAnnul" aria-labelledby="offcanvasAddFraisAnnulLabel">
  <div class="offcanvas-header border-bottom">
    <h5 id="offcanvasAddFraisAnnulLabel" class="offcanvas-title">Ajouter un frais</h5>
    <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Fermer"></button>
  </div>
  <div class="offcanvas-body mx-0 flex-grow-0 p-6 h-100">
    {{ include('frais_annul/_form.html.twig', {
      form: addForm,
      button_label: 'Enregistrer'
    }) }}
  </div>
</div>

<!-- Offcanvas pour modifier un frais -->
{% if editForm is defined and editForm %}
  <div class="offcanvas offcanvas-end show" tabindex="-1" id="offcanvasEditFraisAnnul" style="visibility: visible;" aria-labelledby="offcanvasEditFraisAnnulLabel">
    <div class="offcanvas-header border-bottom">
      <h5 id="offcanvasEditFraisAnnulLabel" class="offcanvas-title">Modifier le frais</h5>
      <a href="{{ path('app_frais_annul_index') }}" class="btn-close text-reset" aria-label="Fermer"></a>
    </div>
    <div class="offcanvas-body mx-0 flex-grow-0 p-6 h-100">
      {{ include('frais_annul/_form.html.twig', {
        form: editForm,
        button_label: 'Mettre à jour'
      }) }}
    </div>
  </div>
{% endif %}
{% endblock %}
