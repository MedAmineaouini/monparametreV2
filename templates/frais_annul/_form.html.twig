<div class="card-body p-1" style="font-size: 12px">
    {{ form_start(form, {'attr': {'class': 'browser-default-validation'}}) }}

    <div class="row g-3 mb-4 align-items-center">
        <div class="col-md-12">
            {{ form_label(form.jour1, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
            {{ form_widget(form.jour1, {'attr': {'class': 'form-control', 'placeholder': 'Jour 1'}}) }}
        </div>
        <div class="col-md-12">
            {{ form_label(form.jour2, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
            {{ form_widget(form.jour2, {'attr': {'class': 'form-control', 'placeholder': 'Jour 2'}}) }}
        </div>
    </div>

    <div class="row g-3 mb-4 align-items-center">
        <div class="col-md-12">
            {{ form_label(form.facteur, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
            {{ form_widget(form.facteur, {'attr': {'class': 'form-control', 'placeholder': 'Facteur'}}) }}
        </div>
        <div class="col-md-12">
            {{ form_label(form.typeannul, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
            <div>
                {{ form_widget(form.typeannul) }}
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-12">
            {{ form_label(form.libelle, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
            {{ form_widget(form.libelle, {'attr': {'class': 'form-control', 'placeholder': 'Libellé'}}) }}
        </div>
    </div>

    <div class="row g-3 mb-4 align-items-center">
        <div class="col-md-12">
            {{ form_label(form.bareme, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
            {{ form_widget(form.bareme, {'attr': {'class': 'form-control', 'placeholder': 'Barème'}}) }}
        </div>
        <div class="col-md-12">
            {{ form_label(form.montantmini, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
            {{ form_widget(form.montantmini, {'attr': {'class': 'form-control', 'placeholder': 'Montant minimum'}}) }}
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-12">
            {{ form_label(form.applicable, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
            {{ form_widget(form.applicable, {'attr': {'class': 'form-control'}}) }}
        </div>
    </div>

    <div class="pt-3 border-top text-end">
        <button type="submit" class="btn btn-primary w-100 mb-2">
            <i class="bx bx-save me-2"></i>{{ button_label|default('Enregistrer') }}
        </button>
        {% if form.vars.data.seqannul is defined and form.vars.data.seqannul %}
            <a href="{{ path('app_frais_annul_index') }}" class="btn btn-outline-danger w-100 px-4">
                <i class="bx bx-x me-2"></i>Annuler
            </a>
        {% else %}
            <button type="button" class="btn btn-outline-danger w-100 px-4" data-bs-dismiss="offcanvas">
                <i class="bx bx-x me-2"></i>Annuler
            </button>
        {% endif %}
    </div>

    {{ form_end(form) }}
</div>
