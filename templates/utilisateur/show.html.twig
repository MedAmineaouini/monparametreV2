{% extends 'base.html.twig' %}

{% block title %}Utilisateur{% endblock %}

{% block content %}
<div class="container-xxl flex-grow-1 container-p-y">
  <div class="card mb-6">
    <div class="card-header">
      <h5 class="card-title m-0">Détails de l'utilisateur</h5>
    </div>
    <div class="card-body pt-1">
      <ul class="timeline pb-0 mb-0">
        {% for label, value in {
          'SEQUTIL': utilisateur.SEQUTIL,
          'MAJ': utilisateur.MAJ ? utilisateur.MAJ|date('Y-m-d H:i:s') : '',
          'CODEUTIL': utilisateur.CODEUTIL,
          'NOMUTIL': utilisateur.NOMUTIL,
          'PROFILUTIL': utilisateur.PROFILUTIL,
          'MDP': utilisateur.MDP,
          'BADGE': utilisateur.BADGE,
          'FLAG1': utilisateur.FLAG1 ? 'Yes' : 'No',
          'FLAG2': utilisateur.FLAG2 ? 'Yes' : 'No',
          'DATEDEB': utilisateur.DATEDEB ? utilisateur.DATEDEB|date('Y-m-d H:i:s') : '',
          'HEURED': utilisateur.HEURED ? utilisateur.HEURED|date('Y-m-d H:i:s') : '',
          'DATEFIN': utilisateur.DATEFIN ? utilisateur.DATEFIN|date('Y-m-d H:i:s') : '',
          'HEUREF': utilisateur.HEUREF ? utilisateur.HEUREF|date('Y-m-d H:i:s') : '',
          'ENCOURS': utilisateur.ENCOURS ? 'Yes' : 'No',
          'SEQNIVEAU': utilisateur.SEQNIVEAU,
          'emailutil': utilisateur.emailutil,
          'WEBLOGIN': utilisateur.WEBLOGIN,
          'WEBMDP': utilisateur.WEBMDP
        } %}
          <li class="timeline-item timeline-item-transparent border-primary">
            <span class="timeline-point timeline-point-primary"></span>
            <div class="timeline-event">
              <div class="timeline-header">
                <h6 class="mb-0">{{ label }}</h6>
              </div>
              <p class="mt-3">{{ value }}</p>
            </div>
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>

  <a href="{{ path('app_utilisateur_index') }}">retourner vers liste</a>
  <a href="{{ path('app_utilisateur_edit', {'SEQUTIL': utilisateur.SEQUTIL}) }}">Mettre à jour</a>
  {{ include('utilisateur/_delete_form.html.twig') }}
</div>
{% endblock %}
