{% extends 'base2.html.twig' %}

{% block title %}RFT | Listes Utilisateurs{% endblock %}
{% block body %}
    <div class="card shadow rounded-3 border-0">
        <div class="card-header text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">📋  Listes des utilisateurs</h5>
            <a href="{{ path('app_utilisateur_new') }}" class="btn btn-success btn-sm">
                <i class="bx bx-plus"></i> Nouveau utilisateur
            </a>
        </div>
<hr>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped align-middle small">
                    <thead >
                        <th>#</th>
                        <th>Code</th>
                        <th>Nom</th>
                        <th>Mot de passe</th>
                        <th>Email</th>
                        <th>Niveau</th>
                        <th>Actions</th>
                    </thead>
                    <tbody>
                    {% for utilisateur in utilisateurs %}
                        <tr>
                            <td>{{ utilisateur.SEQUTIL }}</td>
                            <td>{{ utilisateur.CODEUTIL }}</td>
                            <td>{{ utilisateur.NOMUTIL }}</td>
                            <td>{{ utilisateur.MDP }}</td>
                            <td>{{ utilisateur.EMAILUTIL }}</td>
                            <td>
                                {% if utilisateur.SEQNIVEAU %}
                                    <span class="badge bg-success">Administrateur</span>
                                {% else %}
                                    <span class="badge bg-secondary">Utilisateur</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="dropdown">
                                    <button type="button" class="btn p-0 dropdown-toggle hide-arrow"
                                            data-bs-toggle="dropdown">
                                        <i class="icon-base bx bx-dots-vertical-rounded"></i>
                                    </button>
                                    <div class="dropdown-menu">
                                        <a class="dropdown-item"
                                           href="{{ path('app_utilisateur_edit', {'SEQUTIL': utilisateur.SEQUTIL}) }}">
                                            <i class="icon-base bx bx-edit-alt me-1"></i> Consulter / Modifier
                                        </a>
                                      
                                         {{ include('utilisateur/_delete_form.html.twig') }}
                                    </div>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="text-center text-muted">Aucun utilisateur trouvé.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

{% endblock %}



