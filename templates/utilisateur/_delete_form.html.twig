<form method="post" action="{{ path('app_utilisateur_delete', {'SEQUTIL': utilisateur.SEQUTIL}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet utilisatur ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ utilisateur.SEQUTIL) }}">
    <button class="btn">Supprimer</button>
</form>
