<div class="card mb-4">
    <h5 class="card-header">Formulaire Utilisateur</h5>
    {{ form_start(form) }}
    <div class="card-body">
        <div class="row g-4">

            <div class="col-md-6">
                {% for field in [form.MAJ, form.CODEUTIL, form.NOMUTIL, form.PROFILUTIL, form.MDP, form.BADGE, form.FLAG1, form.FLAG2] %}
                    <div class="form-floating form-floating-outline{% if not loop.first %} mt-4{% endif %}">
                        {{ form_widget(field, { 'attr': { 'class': 'form-control', 'placeholder': field.vars.label } }) }}
                        {{ form_label(field) }}
                    </div>
                {% endfor %}
            </div>

            <div class="col-md-6">
                {% for field in [form.DATEDEB, form.HEURED, form.DATEFIN, form.HEUREF, form.ENCOURS, form.SEQNIVEAU, form.emailutil, form.WEBLOGIN, form.WEBMDP] %}
                    <div class="form-floating form-floating-outline{% if not loop.first %} mt-4{% endif %}">
                        {{ form_widget(field, { 'attr': { 'class': 'form-control', 'placeholder': field.vars.label } }) }}
                        {{ form_label(field) }}
                    </div>
                {% endfor %}
            </div>

        </div>

        <div class="pt-4 d-flex justify-content-end">
            <button type="submit" class="btn btn-primary me-3">{{ button_label|default('Enregistrer') }}</button>
            <a href="{{ path('app_utilisateur_index') }}" class="btn btn-label-secondary">Annuler</a>
        </div>
    </div>
    {{ form_end(form) }}
</div>
