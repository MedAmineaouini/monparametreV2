{% extends 'base.html.twig' %}

{% block title %}Liste des Sous-Pays{% endblock %}

{% block body %}
  <div class="container-xxl flex-grow-1 container-p-y">
    <div class="card">
      <div class="card-header border-bottom">
        <h5 class="card-title mb-0">📋 Liste des Sous-Pays</h5>
        <div class="d-flex justify-content-end align-items-center row pt-4 gap-md-0 g-6">
          <div class="col-md-4 d-flex justify-content-end">
            <button class="btn btn-success" data-bs-toggle="offcanvas" data-bs-target="#offcanvasAddSousPays">
              <i class="icon-base bx bx-plus me-2"></i>Ajouter un sous-pays
            </button>
          </div>
        </div>
      </div>
      <div class="card-datatable">
        <table class="datatables-souspays table border-top">
          <thead>
            <tr>
              <th>#</th>
              <th>Libellé</th>
              <th>TUN</th>
              <th>MIR</th>
              <th>NBE</th>
              <th>DJE</th>
              <th>TOE</th>
              <th>TUN Vente</th>
              <th>MIR Vente</th>
              <th>NBE Vente</th>
              <th>DJE Vente</th>
              <th>TOE Vente</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {% for souspay in souspays %}
              <tr>
                <td>{{ souspay.seqsouspays }}</td>
                <td>{{ souspay.libsouspays }}</td>
                <td>{{ souspay.tun }}</td>
                <td>{{ souspay.mir }}</td>
                <td>{{ souspay.nbe }}</td>
                <td>{{ souspay.dje }}</td>
                <td>{{ souspay.toe }}</td>
                <td>{{ souspay.tunvente }}</td>
                <td>{{ souspay.mirvente }}</td>
                <td>{{ souspay.nbevente }}</td>
                <td>{{ souspay.djevente }}</td>
                <td>{{ souspay.toevente }}</td>
                <td>
                  <div class="dropdown">
                    <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                      <i class="icon-base bx bx-dots-vertical-rounded"></i>
                    </button>
                    <div class="dropdown-menu">
                      <a class="dropdown-item" href="{{ path('app_souspays_index', {'edit': souspay.seqsouspays}) }}">
                        <i class="icon-base bx bx-edit-alt me-1"></i> Modifier
                      </a>
                      {{ include('souspays/_delete_form.html.twig', {'seqsouspays': souspay.seqsouspays}) }}
                    </div>
                  </div>
                </td>
              </tr>
            {% else %}
              <tr>
                <td colspan="13" class="text-center">Aucun sous-pays trouvé</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Offcanvas pour ajouter un sous-pays -->
  <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasAddSousPays" aria-labelledby="offcanvasAddSousPaysLabel">
    <div class="offcanvas-header border-bottom">
      <h5 id="offcanvasAddSousPaysLabel" class="offcanvas-title">Ajouter un sous-pays</h5>
      <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body mx-0 flex-grow-0 p-6 h-100">
      {{ include('souspays/_form.html.twig', {
        form: addForm,
        button_label: 'Enregistrer'
      }) }}
    </div>
  </div>

  <!-- Offcanvas pour modifier un sous-pays -->
  {% if editForm is defined and editForm %}
    <div class="offcanvas offcanvas-end show" tabindex="-1" id="offcanvasEditSousPays" style="visibility: visible;" aria-labelledby="offcanvasEditSousPaysLabel">
      <div class="offcanvas-header border-bottom">
        <h5 id="offcanvasEditSousPaysLabel" class="offcanvas-title">Modifier le sous-pays</h5>
        <a href="{{ path('app_souspays_index') }}" class="btn-close text-reset" aria-label="Close"></a>
      </div>
      <div class="offcanvas-body mx-0 flex-grow-0 p-6 h-100">
        {{ include('souspays/_form.html.twig', {
          form: editForm,
          button_label: 'Mettre à jour'
        }) }}
      </div>
    </div>
  {% endif %}
{% endblock %}