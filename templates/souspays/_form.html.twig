<div class="card-body p-1" style="font-size: 12px">
    {{ form_start(form, {'attr': {'class': 'browser-default-validation'}}) }}

    <div class="row g-3 mb-4 align-items-center">
        <div class="col-md-12">
            {{ form_label(form.libsouspays, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
            <strong class="text-danger">*</strong>
            {{ form_widget(form.libsouspays, {'attr': {'class': 'form-control', 'required': 'required'}}) }}
        </div>

        <div class="col-md-12">
            {{ form_label(form.tun, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
            {{ form_widget(form.tun, {'attr': {'class': 'form-control'}}) }}
        </div>

        <div class="col-md-12">
            {{ form_label(form.mir, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
            {{ form_widget(form.mir, {'attr': {'class': 'form-control'}}) }}
        </div>
    </div>

    <div class="row g-3 mb-4 align-items-center">
        <div class="col-md-12">
            {{ form_label(form.nbe, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
            {{ form_widget(form.nbe, {'attr': {'class': 'form-control'}}) }}
        </div>

        <div class="col-md-12">
            {{ form_label(form.dje, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
            {{ form_widget(form.dje, {'attr': {'class': 'form-control'}}) }}
        </div>

        <div class="col-md-12">
            {{ form_label(form.toe, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
            {{ form_widget(form.toe, {'attr': {'class': 'form-control'}}) }}
        </div>
    </div>

    <div class="row g-3 mb-4 align-items-center">
        <div class="col-md-12">
            {{ form_label(form.tunvente, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
            {{ form_widget(form.tunvente, {'attr': {'class': 'form-control'}}) }}
        </div>

        <div class="col-md-12">
            {{ form_label(form.mirvente, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
            {{ form_widget(form.mirvente, {'attr': {'class': 'form-control'}}) }}
        </div>

        <div class="col-md-12">
            {{ form_label(form.nbevente, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
            {{ form_widget(form.nbevente, {'attr': {'class': 'form-control'}}) }}
        </div>
    </div>

    <div class="row g-3 mb-4 align-items-center">
        <div class="col-md-12">
            {{ form_label(form.djevente, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
            {{ form_widget(form.djevente, {'attr': {'class': 'form-control'}}) }}
        </div>

        <div class="col-md-12">
            {{ form_label(form.toevente, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
            {{ form_widget(form.toevente, {'attr': {'class': 'form-control'}}) }}
        </div>

        <div class="col-md-12">
            {{ form_label(form.pays, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
            <strong class="text-danger">*</strong>
            {{ form_widget(form.pays, {'attr': {'class': 'form-control', 'required': 'required'}}) }}
        </div>
    </div>

    <div class="pt-3 border-top text-end">
        <button type="submit" class="btn btn-primary w-100 mb-2">
            <i class="bx bx-save me-2"></i>{{ button_label|default('Enregistrer') }}
        </button>
         {% if form.vars.data.seqsouspays %}
            <a href="{{ path('app_souspays_index') }}" class="btn btn-outline-danger w-100 px-4">
                <i class="bx bx-x me-2"></i>Annuler
            </a>
        {% else %}
            <button type="button" class="btn btn-outline-danger w-100 px-4" data-bs-dismiss="offcanvas">
                <i class="bx bx-x me-2"></i>Annuler
            </button>
        {% endif %}
    </div>

    {{ form_end(form) }}
</div>