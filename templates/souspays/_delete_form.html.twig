<form method="post" action="{{ path('app_souspays_delete', {'seqsouspays': souspay.seqsouspays}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ souspay.seqsouspays) }}">
    <button type="submit" class="dropdown-item text-danger border-0 bg-transparent w-100 text-start">
        <i class="icon-base bx bx-trash me-1"></i> Supprimer
    </button>
</form>
