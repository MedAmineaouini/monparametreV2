<form method="post" 
      action="{{ path('app_souspays_delete', {'seqsouspays': souspay.seqsouspays}) }}" 
      class="delete-form">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ souspay.seqsouspays) }}">
    <button type="button" 
            class="dropdown-item text-danger border-0 bg-transparent w-100 text-start delete-btn"
            data-confirm-message="Êtes-vous sûr de vouloir supprimer ce sous-pays ?"
            data-success-message="Le sous-pays a été supprimé avec succès">
        <i class="icon-base bx bx-trash me-1"></i> Supprimer
    </button>
</form>