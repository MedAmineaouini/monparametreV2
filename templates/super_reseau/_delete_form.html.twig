<form method="post"
      action="{{ path('app_super_reseau_delete', {'seqsuperreseau': super_reseau.seqsuperreseau}) }}"
      class="delete-form">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ super_reseau.seqsuperreseau) }}">
    <button type="button"
            class="dropdown-item text-danger border-0 bg-transparent w-100 text-start delete-btn"
            data-entity-type="ce super réseau"
            data-confirm-message="Êtes-vous sûr de vouloir supprimer ce super réseau ? Cette action est irréversible."
            data-success-message="Le super réseau a été supprimé avec succès">
        <i class="icon-base bx bx-trash me-1"></i> Supprimer
    </button>
</form>