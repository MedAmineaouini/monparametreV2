{# templates/pays/_delete_form.html.twig #}

<form method="post" action="{{ path('app_pays_delete', {'IDPAYS': pay.IDPAYS}) }}" class="d-inline">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ pay.IDPAYS) }}">
    <button type="submit" class="btn btn-danger" onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce pays ?')">
        <i class="icon-base bx bx-trash"></i> Supprimer
    </button>
</form>