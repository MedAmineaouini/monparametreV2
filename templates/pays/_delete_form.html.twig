<form method="post" action="{{ path('app_pays_delete', {'IDPAYS': pay.IDPAYS}) }}" class="d-inline delete-form" onsubmit="return false;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ pay.IDPAYS) }}">
    <button type="submit" class="btn btn-sm btn-danger delete-btn" title="Supprimer">
        <i class="bx bx-trash"></i> Supprimer
    </button>
</form>
