{% extends 'base.html.twig' %}

{% block title %}RFT | Liste des pays{% endblock %}

{% block body %}

    <div class="card shadow rounded-3 border-0">
        <div class="card-header text-white">
            <div class="row align-items-center">
                <div class="col-12 col-md-8 mb-2 mb-md-0">
                    <h5 class="mb-0 text-center text-md-start">📋 Liste des pays</h5>
                </div>
                <div class="col-9 col-md-4 d-flex flex-column flex-md-row justify-content-md-end gap-2">
                    <button class="btn btn-success w-100 w-md-auto" data-bs-toggle="offcanvas" data-bs-target="#offcanvasAddPays">
                        <i class="bx bx-plus me-2"></i>Ajouter un pays
                    </button>
{#                    <a href="{{ path('app_pays_export_pdf') }}" class="btn btn-danger w-100 w-md-auto">#}
{#                        <i class="bx bxs-file-pdf me-2"></i>Export PDF#}
{#                    </a>#}
                </div>
            </div>
        </div>
        <div class="card-body p-1">
            <div class="table-responsive">
                <table class="table table-hover table-striped table-bordered mb-1">
                    <thead>
                        <tr>
                            <th class="text-center" width="60">#</th>
                            <th>Code pays</th>
                            <th>Libellé</th>
                            <th>Place</th>
                            <th class="text-center">Nature</th>
                            <th class="text-center" width="100">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for pay in pays %}
                        <tr>
                            <td class="text-center">{{ pay.IDPAYS }}</td>
                            <td>{{ pay.CODEPAYS }}</td>
                            <td>{{ pay.LIBPAYS }}</td>
                            <td>{{ pay.PLACE }}</td>
                            <td class="text-center">
                                <span class="badge bg-{{ pay.NATURE == 1 ? 'info' : 'primary' }}">
                                    {{ pay.NATURE == 1 ? 'Moyen courrier' : 'Long courrier' }}
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="dropdown">
                                    <button type="button"
                                            class="btn p-0 dropdown-toggle hide-arrow"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false"
                                            aria-label="Actions">
                                        <i class="bx bx-dots-vertical-rounded"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <a class="dropdown-item"
                                               href="{{ path('app_pays_index', {'edit': pay.IDPAYS}) }}"
                                               aria-label="Modifier">
                                                <i class="bx bx-edit-alt me-2"></i>Consulter | Modifier
                                            </a>
                                        </li>
                                        <li>
                                            {{ include('pays/_delete_form.html.twig', {
                                                'pay': pay,
                                                'btn_class': 'dropdown-item'
                                            }) }}
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                Aucun pays enregistré
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Offcanvas pour ajouter un pays -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasAddPays" aria-labelledby="offcanvasAddPaysLabel" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="offcanvas-header border-bottom">
            <h5 id="offcanvasAddPaysLabel" class="offcanvas-title">Ajouter un pays</h5>
            <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Fermer"></button>
        </div>
        <div class="offcanvas-body mx-0 flex-grow-0 p-6 h-100">
            {{ include('pays/_form.html.twig', {
                form: addForm,
                button_label: 'Enregistrer'
            }) }}
        </div>
    </div>

    <!-- Offcanvas pour modifier un pays -->
    {% if editForm is defined and editForm %}
        <div class="offcanvas offcanvas-end show" tabindex="-1" id="offcanvasEditPays" data-bs-backdrop="static" data-bs-keyboard="false" style="visibility: visible;" aria-labelledby="offcanvasEditPaysLabel">
            <div class="offcanvas-header border-bottom">
                <h5 id="offcanvasEditPaysLabel" class="offcanvas-title">Modifier le pays</h5>
                <a href="{{ path('app_pays_index') }}" class="btn-close text-reset" aria-label="Fermer"></a>
            </div>
            <div class="offcanvas-body mx-0 flex-grow-0 p-6 h-100">
                {{ form_start(editForm, {
                    'action': path('app_pays_index', {'edit': payToEdit.IDPAYS}),
                    'attr': {'id': 'edit-form'}
                }) }}
                {{ form_widget(editForm) }}
                <hr>
                <button type="submit" class="btn btn-primary w-100 mb-2">
                    <i class="bx bx-save me-2"></i>Enregistrer
                </button>
                <a href="{{ path('app_pays_index') }}" class="btn btn-outline-danger w-100 px-4">
                    <i class="bx bx-x me-2"></i>Annuler
                </a>
                {{ form_end(editForm) }}
            </div>
        </div>

        <script>
            // Fermer l'offcanvas d'ajout si l'offcanvas d'édition est ouvert
            const addOffcanvas = document.getElementById('offcanvasAddPays');
            if (addOffcanvas) {
                const bsAddOffcanvas = bootstrap.Offcanvas.getInstance(addOffcanvas);
                if (bsAddOffcanvas) {
                    bsAddOffcanvas.hide();
                }
            }
        </script>
    {% endif %}
{% endblock %}