{% extends 'base2.html.twig' %}

{% block title %}Liste des pays{% endblock %}

{% block body %}

  <div class="container-xxl flex-grow-1 container-p-y">
    <div class="card">
      <div class="card-header border-bottom">
        <h5 class="card-title mb-0">📋 Liste des pays</h5>
        <div class="d-flex justify-content-end align-items-center row pt-4 gap-md-0 g-6">
          <div class="col-md-4 d-flex justify-content-end">
            <button class="btn btn-success" data-bs-toggle="offcanvas" data-bs-target="#offcanvasAddPays">
              <i class="icon-base bx bx-plus me-2"></i>Ajouter un pays
            </button>
          </div>
        </div>
      </div>
      <div class="card-datatable">
        <table class="datatables-pays table border-top">
          <thead>
            <tr>
              <th>ID</th>
              <th>Code pays</th>
              <th>Libellé</th>

              <th>Place</th>
              <th>Nature</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {% for pay in pays %}
              <tr>
                <td>{{ pay.IDPAYS }}</td>
                <td>{{ pay.CODEPAYS }}</td>
                <td>{{ pay.LIBPAYS }}</td>
                <td>{{ pay.PLACE }}</td>
                <td>{{ pay.NATURE == 1 ? 'Moyen courrier' : 'Long courrier' }}</td>
                <td>
                  <div class="dropdown">
                    <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                      <i class="icon-base bx bx-dots-vertical-rounded"></i>
                    </button>
                    <div class="dropdown-menu">
                      <a class="dropdown-item" href="{{ path('app_pays_index', {'edit': pay.IDPAYS}) }}">
                        <i class="icon-base bx bx-edit-alt me-1"></i> Modifier
                      </a>
                      {{ include('pays/_delete_form.html.twig', {'pay': pay}) }}
                    </div>
                  </div>
                </td>
              </tr>
            {% else %}
              <tr>
                <td colspan="7" class="text-center">Aucun pays trouvé</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>
  {# Afficher la modal d'erreur si un message flash "error" existe #}
  {% for message in app.flashes('error') %}
    <div class="modal fade" id="errorModal" tabindex="-1" aria-labelledby="errorModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-danger">
          <div class="modal-header text-white">
            <h5 class="modal-title" id="errorModalLabel">Erreur de suppression</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
          </div>
          <div class="modal-body">
            {{ message }}
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
          </div>
        </div>
      </div>
    </div>
  {% endfor %}

  <!-- Offcanvas pour ajouter un pays -->
  <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasAddPays" aria-labelledby="offcanvasAddPaysLabel">
    <div class="offcanvas-header border-bottom">
      <h5 id="offcanvasAddPaysLabel" class="offcanvas-title">Ajouter un pays</h5>
      <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body mx-0 flex-grow-0 p-6 h-100">
      {{ include('pays/_form.html.twig', {
        form: addForm,
        button_label: 'Enregistrer'
      }) }}
    </div>
  </div>

  <!-- Offcanvas pour modifier un pays -->
  {% if editForm is defined and editForm %}
    <div class="offcanvas offcanvas-end show" tabindex="-1" id="offcanvasEditPays" style="visibility: visible;" aria-labelledby="offcanvasEditPaysLabel">
      <div class="offcanvas-header border-bottom">
        <h5 id="offcanvasEditPaysLabel" class="offcanvas-title">Modifier le pays</h5>
        <a href="{{ path('app_pays_index') }}" class="btn-close text-reset" aria-label="Close"></a>
      </div>
      <div class="offcanvas-body mx-0 flex-grow-0 p-6 h-100">
        {{ include('pays/_form.html.twig', {
          form: editForm,
          button_label: 'Mettre à jour'
        }) }}
      </div>
    </div>
  {% endif %}
{% endblock %}
{% block javascripts %}
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      {% for message in app.flashes('error') %}
      Swal.fire({
        title: 'Erreur',
        text: '{{ message|e('js') }}',
        icon: 'error',
        confirmButtonText: 'OK',
      });
      {% endfor %}

      {% for message in app.flashes('success') %}
      Swal.fire({
        title: 'Succès',
        text: '{{ message|e('js') }}',
        icon: 'success',
        timer: 2000,
        showConfirmButton: false,
      });
      {% endfor %}
    });
  </script>
{% endblock %}
