{% extends 'base2.html.twig' %}

{% block title %}RFT | Listes Pays{% endblock %}
{% block body %}
    <div class="card shadow rounded-3 border-0">
        <div class="card-header text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">📋  Listes des pays</h5>
            <a href="{{ path('app_pays_new') }}" class="btn btn-success btn-sm">
                <i class="bx bx-plus"></i> Nouveau pays
            </a>
        </div>
<hr>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped align-middle small">
                    <thead >
                        <th>#</th>
                        <th>Code pays</th>
                        <th>Libellé</th>
                        <th>Place</th>
                         <th>Nature</th>
                        <th>Actions</th>
                    </thead>
                    <tbody>
                    {% for pay in pays %}
                        <tr>
                           <td>{{ pay.IDPAYS }}</td>
                            <td>{{ pay.CODEPAYS }}</td>
                            <td>{{ pay.LIBPAYS }}</td>
                            <td>{{ pay.PLACE }}</td>
                            <td>{{ pay.NATURE == 1 ? 'Moyen courrier' : 'Long courrier' }}</td>
                            </td>
                            <td>
                                <div class="dropdown">
                                    <button type="button" class="btn p-0 dropdown-toggle hide-arrow"
                                            data-bs-toggle="dropdown">
                                        <i class="icon-base bx bx-dots-vertical-rounded"></i>
                                    </button>
                                    <div class="dropdown-menu">
                                        <a class="dropdown-item"
                                           href="{{ path('app_pays_edit', {'IDPAYS': pay.IDPAYS}) }}">
                                            <i class="icon-base bx bx-edit-alt me-1"></i> Consulter / Modifier
                                        </a>

                                         {{ include('pays/_delete_form.html.twig') }}
                                    </div>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" style="text-align: center" class="text-center text-muted">aucun enregistrement trouvé.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

{% endblock %}