<div class="card-body p-1" style="font-size: 12px">
    {{ form_start(form, {'attr': {'class': 'browser-default-validation'}}) }}

    <div class="row g-3 mb-4">
        <div class="col-md-12">
            {{ form_label(form.codaffret, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
            {{ form_widget(form.codaffret, {
                'attr': {
                    'class': 'form-control',
                    'placeholder': 'Code affréteur (3 caractères)'
                }
            }) }}
            {{ form_errors(form.codaffret) }}
        </div>
        <div class="col-md-12">
            {{ form_label(form.libaffret, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
            {{ form_widget(form.libaffret, {
                'attr': {
                    'class': 'form-control',
                    'placeholder': 'Libellé affréteur'
                }
            }) }}
            {{ form_errors(form.libaffret) }}
        </div>
    </div>

{#    <div class="row g-3 mb-4">#}
{#        <div class="col-md-12">#}
{#            {{ form_label(form.compagnie, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}#}
{#            {{ form_widget(form.compagnie, {#}
{#                'attr': {#}
{#                    'class': 'form-check-input',#}
{#                    'placeholder': 'Compagnie'#}
{#                }#}
{#            }) }}#}
{#            {{ form_errors(form.compagnie) }}#}
{#        </div>#}
{#    </div>#}

    <div class="pt-3 border-top text-end">
        <button type="submit" class="btn btn-primary w-100 mb-2">
            <i class="bx bx-save me-2"></i>{{ button_label|default('Enregistrer') }}
        </button>

        {% if form.vars.data.seqaffret is defined and form.vars.data.seqaffret %}
            <a href="{{ path('app_affreteur_index') }}" class="btn btn-outline-danger w-100 px-4">
                <i class="bx bx-x me-2"></i>Annuler
            </a>
        {% else %}
            <button type="button" class="btn btn-outline-danger w-100 px-4" data-bs-dismiss="offcanvas">
                <i class="bx bx-x me-2"></i>Annuler
            </button>
        {% endif %}
    </div>

    {{ form_end(form) }}
</div>