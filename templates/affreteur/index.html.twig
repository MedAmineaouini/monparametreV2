{% extends 'base.html.twig' %}

{% block title %}Liste des affréteurs{% endblock %}

{% block body %}
    <div class="flex-grow-1 container-p-y container-fluid">
        <div class="card shadow rounded-3 border-0">
            <div class="card-header text-white">
                <div class="row align-items-center">
                    <div class="col-12 col-md-10 mb-2 mb-md-0">
                        <h5 class="mb-0 text-center text-md-start">📋 Liste des affréteurs</h5>
                    </div>
                    <div class="col-9 col-md-2 d-flex flex-column flex-md-row justify-content-md-end gap-2">
                        <button class="btn btn-success w-100 w-md-auto" data-bs-toggle="offcanvas" data-bs-target="#offcanvasAddAffreteur">
                            <i class="bx bx-plus me-2"></i>Ajouter un affréteur
                        </button>
                    </div>
                </div>
            </div>

            <div class="card-body p-1" style="font-size: 12px;">
                <div class="table-responsive">
                    <table class="table table-hover table-striped table-bordered mb-1">
                        <thead>
                        <tr>
                            <th class="text-center" width="60">#</th>
                            <th>Code</th>
                            <th>Libellé</th>
{#                            <th>Compagnie</th>#}
                            <th class="text-center" width="100">Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for affreteur in affreteurs %}
                            <tr>
                                <td class="text-center">{{ affreteur.seqaffret }}</td>
                                <td>{{ affreteur.codaffret }}</td>
                                <td>{{ affreteur.libaffret }}</td>
{#                                <td>{{ affreteur.compagnie ? 'Oui' : 'Non' }}</td>#}
                                <td class="text-center">
                                    <div class="dropdown">
                                        <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Actions">
                                            <i class="bx bx-dots-vertical-rounded"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <a class="dropdown-item" href="{{ path('app_affreteur_index', {'edit': affreteur.seqaffret}) }}">
                                                    <i class="bx bx-edit-alt me-2"></i>Consulter | Modifier
                                                </a>
                                            </li>
                                            <li>
                                                {{ include('affreteur/_delete_form.html.twig', {
                                                    affreteur: affreteur,
                                                    btn_class: 'dropdown-item'
                                                }) }}
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">Aucun affréteur trouvé</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    {# Offcanvas Ajout #}
    <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasAddAffreteur"
         aria-labelledby="offcanvasAddAffreteurLabel" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="offcanvas-header border-bottom">
            <h5 id="offcanvasAddAffreteurLabel" class="offcanvas-title">Ajouter un affréteur</h5>
            <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Fermer"></button>
        </div>
        <div class="offcanvas-body mx-0 flex-grow-0 p-6 h-100">
            {{ include('affreteur/_form.html.twig', {
                form: addForm,
                button_label: 'Enregistrer'
            }) }}
        </div>
    </div>

    {# Offcanvas Édition #}
    {% if editForm is defined and editForm %}
        <div class="offcanvas offcanvas-end show" tabindex="-1" id="offcanvasEditAffreteur"
             data-bs-backdrop="static" data-bs-keyboard="false"
             style="visibility: visible;" aria-labelledby="offcanvasEditAffreteurLabel">
            <div class="offcanvas-header border-bottom">
                <h5 id="offcanvasEditAffreteurLabel" class="offcanvas-title">Modifier l'affréteur</h5>
                <a href="{{ path('app_affreteur_index') }}" class="btn-close text-reset" aria-label="Fermer"></a>
            </div>
            <div class="offcanvas-body mx-0 flex-grow-0 p-6 h-100">
                {{ include('affreteur/_form.html.twig', {
                    form: editForm,
                    button_label: 'Enregistrer'
                }) }}
            </div>
        </div>

        <script>
            // Ferme l'offcanvas "ajouter" si l'édition est active
            const addOffcanvas = document.getElementById('offcanvasAddAffreteur');
            if (addOffcanvas) {
                const bsAddOffcanvas = bootstrap.Offcanvas.getInstance(addOffcanvas);
                if (bsAddOffcanvas) {
                    bsAddOffcanvas.hide();
                }
            }
        </script>
    {% endif %}
{% endblock %}