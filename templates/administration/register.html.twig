{% extends 'administration/base.html.twig' %}

{% block title %}Créer un compte {% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/assets/vendor/css/pages/page-auth.css') }}" />
{% endblock %}

{% block content %}
    <div class="container-xxl">
      <div class="authentication-wrapper authentication-basic container-p-y">
        <div class="authentication-inner">
          <div class="card px-sm-6 px-0">
            <div class="card-body">
              <div class="app-brand justify-content-center mb-4">
                <span class="app-brand-logo demo">
                  <!-- Logo ici -->
                </span>
                <span class="app-brand-text demo text-heading fw-bold">solplus</span>
              </div>

              <h4 class="mb-1">Créer un compte 👋</h4>
              <p class="mb-6">Remplissez les champs pour vous inscrire</p>

              <form method="POST" action="{{ path('app_register') }}">
                <div class="mb-3">
                  <label class="form-label" for="nom">Nom</label>
                  <input type="text" 
                         id="nom" 
                         name="nom" 
                         class="form-control {% if errors.nom is defined %}is-invalid{% endif %}" 
                         placeholder="Entrez votre nom" 
                         required />
                  {% if errors.nom is defined %}
                    <div class="invalid-feedback">
                      {% for message in errors.nom %}
                        {{ message }}
                      {% endfor %}
                    </div>
                  {% endif %}
                </div>

                <div class="mb-3">
                  <label class="form-label" for="prenom">Prénom</label>
                  <input type="text" 
                         id="prenom" 
                         name="prenom" 
                         class="form-control {% if errors.prenom is defined %}is-invalid{% endif %}" 
                         placeholder="Entrez votre prénom" 
                         required />
                  {% if errors.prenom is defined %}
                    <div class="invalid-feedback">
                      {% for message in errors.prenom %}
                        {{ message }}
                      {% endfor %}
                    </div>
                  {% endif %}
                </div>

                <div class="mb-3">
                  <label class="form-label" for="email">Email</label>
                  <input type="email" 
                         id="email" 
                         name="email" 
                         class="form-control {% if errors.email is defined %}is-invalid{% endif %}" 
                         placeholder="Entrez votre email" 
                         required />
                  {% if errors.email is defined %}
                    <div class="invalid-feedback">
                      {% for message in errors.email %}
                        {{ message }}
                      {% endfor %}
                    </div>
                  {% endif %}
                </div>

                <div class="mb-3 form-password-toggle">
                  <label class="form-label" for="plainPassword">Mot de passe</label>
                  <div class="input-group input-group-merge">
                    <input
                      type="password"
                      id="plainPassword"
                      name="plainPassword"
                      class="form-control {% if errors.plainPassword is defined %}is-invalid{% endif %}"
                      placeholder="********"
                      required />
                    <span class="input-group-text cursor-pointer"><i class="bx bx-hide"></i></span>
                    {% if errors.plainPassword is defined %}
                      <div class="invalid-feedback">
                        {% for message in errors.plainPassword %}
                          {{ message }}
                        {% endfor %}
                      </div>
                    {% endif %}
                  </div>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}" />

                <div class="mb-3">
                  <button class="btn btn-primary d-grid w-100" type="submit">S'inscrire</button>
                </div>
              </form>

              <div class="text-center">
                <p class="mb-0">Déjà inscrit ? <a href="{{ path('app_login') }}">Se connecter</a></p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
{% endblock %}