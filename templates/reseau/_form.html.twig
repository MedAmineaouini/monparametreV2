<div class="card-body p-3" style="font-size: 13px">
    {{ form_start(form, {'attr': {'class': 'browser-default-validation needs-validation', 'novalidate': 'novalidate'}}) }}

    {# Section Informations générales #}
            <div class="row g-2">
                {# Champ nomreseau #}
                <div class="col-md-6">
                    {{ form_label(form.nomreseau, null, {
                        'label_attr': {'class': 'form-label fw-semibold required'},
                        'label': 'Nom du réseau*'
                    }) }}
                    {{ form_widget(form.nomreseau, {
                        'attr': {
                            'class': 'form-control form-control-sm',
                            'placeholder': 'Saisissez le nom du réseau',
                            'required': 'required'
                        }
                    }) }}
                    <div class="invalid-feedback">
                        Veuillez saisir le nom du réseau.
                    </div>
                </div>

                {# Champ emailReseau #}
                <div class="col-md-6">
                    {{ form_label(form.emailReseau, null, {
                        'label_attr': {'class': 'form-label fw-semibold'},
                        'label': 'Email du réseau'
                    }) }}
                    {{ form_widget(form.emailReseau, {
                        'attr': {
                            'class': 'form-control form-control-sm',
                            'placeholder': 'email@reseau.com'
                        }
                    }) }}
                </div>

                {# Champ codeorx #}
                <div class="col-md-3">
                    {{ form_label(form.codeorx, null, {
                        'label_attr': {'class': 'form-label fw-semibold'},
                        'label': 'Code ORX'
                    }) }}
                    {{ form_widget(form.codeorx, {
                        'attr': {
                            'class': 'form-control form-control-sm',
                            'placeholder': 'Code ORX'
                        }
                    }) }}
                </div>

                {# Champ datesaisie #}
                <div class="col-md-3">
                    {{ form_label(form.datesaisie, null, {
                        'label_attr': {'class': 'form-label fw-semibold'},
                        'label': 'Date de saisie'
                    }) }}

                    <div class="input-group input-group-sm">
                        {{ form_widget(form.datesaisie, {
                            'attr': {
                                'class': 'form-control',
                                'type': 'date'
                            }
                        }) }}
                    </div>
                    {{ form_errors(form.datesaisie) }}
                </div>
                {# Champ desactive #}
                <div class="col-md-6">
                    <div class="form-check form-switch mt-3">
                        {{ form_widget(form.desactive, {
                            'attr': {
                                'class': 'form-check-input',
                                'role': 'switch'
                            }
                        }) }}
                        {{ form_label(form.desactive, null, {
                            'label_attr': {'class': 'form-check-label fw-semibold'},
                            'label': 'Réseau désactivé'
                        }) }}
                    </div>
                </div>

            </div>

            <div class="row g-3">
                {# Champ seqsuperreseau #}
                <div class="col-md-3">
                    {{ form_label(form.seqsuperreseau, null, {
                        'label_attr': {'class': 'form-label fw-semibold'},
                        'label': 'Super réseau'
                    }) }}
                    {{ form_widget(form.seqsuperreseau, {
                        'attr': {
                            'class': 'form-control form-control-sm',
                            'placeholder': 'Numéro'
                        }
                    }) }}
                </div>

                {# Champ seqtyperegle #}
                <div class="col-md-3">
                    {{ form_label(form.seqtyperegle, null, {
                        'label_attr': {'class': 'form-label fw-semibold'},
                        'label': 'Type règle'
                    }) }}
                    {{ form_widget(form.seqtyperegle, {
                        'attr': {
                            'class': 'form-control form-control-sm',
                            'placeholder': 'Numéro'
                        }
                    }) }}
                </div>

                {# Champ seqtypeclt #}
                <div class="col-md-3">
                    {{ form_label(form.seqtypeclt, null, {
                        'label_attr': {'class': 'form-label fw-semibold'},
                        'label': 'Type client'
                    }) }}
                    {{ form_widget(form.seqtypeclt, {
                        'attr': {
                            'class': 'form-control form-control-sm',
                            'placeholder': 'Numéro'
                        }
                    }) }}
                </div>

                {# Champ seqcomm #}
                <div class="col-md-3">
                    {{ form_label(form.seqcomm, null, {
                        'label_attr': {'class': 'form-label fw-semibold'},
                        'label': 'Commission'
                    }) }}
                    {{ form_widget(form.seqcomm, {
                        'attr': {
                            'class': 'form-control form-control-sm',
                            'placeholder': 'Numéro'
                        }
                    }) }}
                </div>
            </div>

    </div>

{# Boutons d'action #}
<hr>
<div class="card-footer p-3 row justify-content-between">
    <div class="col-auto">
        <a href="{{ path('app_reseau_index') }}" class="btn btn-outline-danger btn-sm w-100 px-4">Annuler</a>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary btn-sm w-100 mb-2">
            <i class="bx bx-save me-2"></i>{{ button_label|default('Enregistrer') }}
        </button>

    </div>
</div>

    {{ form_end(form) }}
