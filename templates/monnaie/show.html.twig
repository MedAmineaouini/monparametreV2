{% extends 'base.html.twig' %}

{% block title %}Monnaie{% endblock %}

{% block body %}
    <h1>Monnaie</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Seqmonnaie</th>
                <td>{{ monnaie.seqmonnaie }}</td>
            </tr>
            <tr>
                <th>Libmonnaie</th>
                <td>{{ monnaie.libmonnaie }}</td>
            </tr>
            <tr>
                <th>Nommonnaie</th>
                <td>{{ monnaie.nommonnaie }}</td>
            </tr>
            <tr>
                <th>Taux</th>
                <td>{{ monnaie.taux }}</td>
            </tr>
            <tr>
                <th>Libpays</th>
                <td>{{ monnaie.libpays }}</td>
            </tr>
            <tr>
                <th>Calcul</th>
                <td>{{ monnaie.calcul }}</td>
            </tr>
            <tr>
                <th>Datemaj</th>
                <td>{{ monnaie.datemaj ? monnaie.datemaj|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Idpays</th>
                <td>{{ monnaie.idpays }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_monnaie_index') }}">back to list</a>

    <a href="{{ path('app_monnaie_edit', {'seqmonnaie': monnaie.seqmonnaie}) }}">edit</a>

    {{ include('monnaie/_delete_form.html.twig') }}
{% endblock %}
