{% extends 'base.html.twig' %}

{% block title %}Liste des Types de produit{% endblock %}

{% block body %}
    <div class="card shadow-sm border-0">
        <div class="card-header text-white">
            <div class="row align-items-center">
                <div class="col-12 col-md-9 mb-2 mb-md-0">
                    <h5 class="mb-0 text-center text-md-start">📋 Liste des types de produit</h5>
                </div>
                <div class="col-12 col-md-3 d-flex flex-column flex-md-row justify-content-md-end gap-2">
                    <button class="btn btn-success w-100 w-md-auto" data-bs-toggle="modal" data-bs-target="#modalTypeprod">
                        <i class="bx bx-plus"></i> Nouveau type produit
                    </button>
                </div>
            </div>
        </div>

        <div class="card-body">
            <table class="table table-hover table-bordered table-striped">
                <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Libellé</th>
                    <th class="text-center">Actions</th>
                </tr>
                </thead>
                <tbody>
                {% for typeprod in typeprods %}
                    <tr>
                        <td>{{ loop.index }}</td>
                        <td>{{ typeprod.LIBTYPEPROD }}</td>
                        <td class="text-center">
                            <div class="dropdown">
                                <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="icon-base bx bx-dots-vertical-rounded"></i>
                                </button>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" href="#"
                                           data-bs-toggle="modal"
                                           data-bs-target="#editModal{{ typeprod.SEQTYPEPROD }}">
                                            <i class="icon-base bx bx-edit-alt me-1"></i> Modifier
                                        </a>

                                        {{ include('typeprod/_delete_form.html.twig', { 'SEQTYPEPROD': typeprod.SEQTYPEPROD }) }}
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>

                    {# Modal édition #}
                    <div class="modal fade" id="editModal{{ typeprod.SEQTYPEPROD }}" tabindex="-1" aria-hidden="true"
                         data-bs-backdrop="static" data-bs-keyboard="false">
                        <div class="modal-dialog modal-dialog-centered" role="document">
                            <div class="modal-content">
                                {{ form_start(forms_edit[typeprod.SEQTYPEPROD]) }}
                                <div class="modal-header">
                                    <h5 class="modal-title">Modifier Type de produit</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="mb-3 row align-items-center">
                                        <label for="{{ forms_edit[typeprod.SEQTYPEPROD].LIBTYPEPROD.vars.id }}" class="col-sm-4 col-form-label fw-semibold">
                                            Libellé <span class="text-danger">*</span>
                                        </label>
                                        <div class="col-sm-8">
                                            {{ form_widget(forms_edit[typeprod.SEQTYPEPROD].LIBTYPEPROD, {attr: {'class': 'form-control', 'placeholder': 'Type de produit'}}) }}
                                            {{ form_errors(forms_edit[typeprod.SEQTYPEPROD].LIBTYPEPROD) }}
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="submit" class="btn btn-primary text-white">
                                        <i class="bx bx-save me-2"></i> Enregistrer
                                    </button>
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                        <i class="bx bx-x me-2"></i> Annuler
                                    </button>
                                </div>
                                {{ form_end(forms_edit[typeprod.SEQTYPEPROD]) }}
                            </div>
                        </div>
                    </div>
                {% else %}
                    <tr><td colspan="3" class="text-center">Aucun type de produit trouvé</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# Modal ajout #}
    <div class="modal fade" id="modalTypeprod" tabindex="-1" aria-hidden="true"
         data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                {{ form_start(form_new) }}
                <div class="modal-header text-white">
                    <h5 class="modal-title">Nouveau Type de produit</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3 row align-items-center">
                        <label for="{{ form_new.LIBTYPEPROD.vars.id }}" class="col-sm-4 col-form-label fw-semibold">
                            Libellé <span class="text-danger">*</span>
                        </label>
                        <div class="col-sm-8">
                            {{ form_widget(form_new.LIBTYPEPROD, {
                                'attr': {
                                    'class': 'form-control',
                                    'maxlength': 20,
                                    'placeholder': 'Type produit',
                                    'required': 'required'
                                }
                            }) }}
                            {{ form_errors(form_new.LIBTYPEPROD) }}
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">
                        <i class="bx bx-save me-2"></i> Enregistrer
                    </button>
                    <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">
                        <i class="bx bx-x me-2"></i> Annuler
                    </button>
                </div>
                {{ form_end(form_new) }}
            </div>
        </div>
    </div>
{% endblock %}
