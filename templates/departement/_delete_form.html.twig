<form method="post"
      action="{{ path('app_departement_delete', {'seqdepartement': departement.seqdepartement}) }}"
      class="delete-form">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ departement.seqdepartement) }}">
    <button type="button"
            class="dropdown-item text-danger border-0 bg-transparent w-100 text-start delete-btn"
            data-entity-type="ce département"
            data-confirm-message="Êtes-vous sûr de vouloir supprimer ce département ? Cette action est irréversible."
            data-success-message="Le département a été supprimé avec succès">
        <i class="icon-base bx bx-trash me-1"></i> Supprimer
    </button>
</form>
