<div class="card-body p-3" style="font-size: 12px">
    {{ form_start(form, {'attr': {'class': 'browser-default-validation', 'novalidate': 'novalidate'}}) }}

    <div class="row g-3 mb-3">
        <div class="col-md-12">
            {{ form_label(form.code_departement, 'Code département', {'label_attr': {'class': 'form-label fw-semibold '}}) }}
            <strong class="text-danger">*</strong>
            {{ form_widget(form.code_departement, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.code_departement) }}
        </div>

        <div class="col-md-12">
            {{ form_label(form.lib_departement, 'Département', {'label_attr': {'class': 'form-label fw-semibold '}}) }}
            <strong class="text-danger">*</strong>
            {{ form_widget(form.lib_departement, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.lib_departement) }}
        </div>

        <div class="col-md-12">
            {{ form_label(form.region, 'Région', {'label_attr': {'class': 'form-label fw-semibold '}}) }}
            {{ form_widget(form.region, {'attr': {'class': 'form-select'}}) }}
            {{ form_errors(form.region) }}
        </div>

        <div class="col-md-12">
            {{ form_label(form.commercialCode, 'Code commercial', {'label_attr': {'class': 'form-label fw-semibold '}}) }}
            {{ form_widget(form.commercialCode, {
                'attr': {
                    'class': 'form-control commercial-code-input',
                    'autocomplete': 'off',
                    'id': 'codeCommercialInput_' ~ form.vars.id
                }
            }) }}
            {{ form_errors(form.commercialCode) }}
        </div>

        <div class="col-md-12">
            {{ form_label(form.commercial, 'Commercial', {'label_attr': {'class': 'form-label fw-semibold '}}) }}
            {{ form_widget(form.commercial, {
                'attr': {
                    'class': 'form-control commercial-name-input',
                    'readonly': true,
                    'id': 'commercialInput_' ~ form.vars.id
                }
            }) }}
            {{ form_errors(form.commercial) }}
        </div>
    </div>

    <div class="pt-3 border-top text-end">
        <button type="submit" class="btn btn-primary w-100 mb-2">
            <i class="bx bx-save me-2"></i> {{ button_label|default('Enregistrer') }}
        </button>

        {% if departementToEdit is defined and departementToEdit %}
            <a href="{{ path('app_departement_index') }}" class="btn btn-outline-secondary w-100">
                <i class="bx bx-x me-2"></i> Annuler
            </a>
        {% else %}
            <button type="button" class="btn btn-outline-secondary w-100" data-bs-dismiss="offcanvas">
                <i class="bx bx-x me-2"></i> Annuler
            </button>
        {% endif %}
    </div>

    {{ form_end(form) }}
</div>