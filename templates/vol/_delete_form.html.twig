<form method="post"
      action="{{ path('app_vol_delete', {'seqvol': vol.seqvol}) }}"
      class="delete-form">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ vol.seqvol) }}">
    <button type="button"
            class="dropdown-item text-danger border-0 bg-transparent w-100 text-start delete-btn"
            data-confirm-message="Êtes-vous sûr de vouloir supprimer cette Vol ?"
            data-success-message="La Vol a été supprimée avec succès">
        <i class="icon-base bx bx-trash me-1"></i> Supprimer
    </button>
</form>