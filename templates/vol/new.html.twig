{% extends 'base.html.twig' %}

{% block title %}RFT | Vol
{% endblock %}

{% block body %}
        <!-- Tab navigation -->
        <ul class="nav nav-tabs mb-4" id="volTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="general-tab" data-bs-toggle="tab" data-bs-target="#general" type="button" role="tab">Général</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="capacities-tab" data-bs-toggle="tab" data-bs-target="#capacities" type="button" role="tab">Capacités</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="pricing-tab" data-bs-toggle="tab" data-bs-target="#pricing" type="button" role="tab">Tarification</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="convocation-tab" data-bs-toggle="tab" data-bs-target="#convocation" type="button" role="tab">Convocation</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="baggage-tab" data-bs-toggle="tab" data-bs-target="#baggage" type="button" role="tab">Bagages</button>
            </li>
            {# <li class="nav-item" role="presentation">
                <button class="nav-link" id="options-tab" data-bs-toggle="tab" data-bs-target="#options" type="button" role="tab">Options</button>
            </li> #}
        </ul>
        
	<div class="card shadow rounded-3 border-0">
		<div class="card-header text-white d-flex justify-content-between align-items-center">
			<h5 class="mb-0">
				<i class="fa fa-plane"></i>
				Vol | Nouveau Vol
			</h5>
		</div>
		<hr>
		<div class="card-body">
			{{ include('vol/_form.html.twig') }}
		</div>
	</div>
{% endblock %}


