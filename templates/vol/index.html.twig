{% extends 'base.html.twig' %}

{% block title %}RFT | Liste des Vols{% endblock %}

{% block body %}
    <div class="flex-grow-1 container-p-y container-fluid">
        <div class="card shadow rounded-3 border-0">
            <div class="card-header text-white">
                <div class="row align-items-center">
                    <div class="col-12 col-md-10 mb-2 mb-md-0">
                        <h5 class="mb-0 text-center text-md-start">✈️ Liste des Vols</h5>
                    </div>
                    <div class="col-9 col-md-2 d-flex flex-column flex-md-row justify-content-md-end gap-2">
                        <a class="btn btn-success w-100 w-md-auto" href="{{ path('app_vol_new') }}">
                            <i class="bx bx-plus me-2"></i>Nouveau Vol
                        </a>
                    </div>
                </div>
            </div>

            <div class="card-body p-1" style="font-size: 12px;">
                <div class="table-responsive">
                    <table class="table table-hover table-striped table-bordered mb-1">
                        <thead class="thead-light">
                        <tr>
                            <th>#</th>
                            <th>Numéro</th>
                            <th>Date</th>
                            <th>Départ</th>
                            <th>Arrivée</th>
                            <th>Compagnie</th>
                            <th>Sièges</th>
                            <th>Statut</th>
                            <th>Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for vol in vols %}
                            <tr>
                                <td>{{ vol.seqvol }}</td>
                                <td>{{ vol.nvol }}</td>
                                <td>{{ vol.datevol ? vol.datevol|date('d/m/Y H:i') : '' }}</td>
                                <td>
                                    {{ vol.villed }} / 
                                    <small>{{ vol.heured }}</small>
                                </td>
                                <td>
                                    {{ vol.villea }} /
                                    <small>{{ vol.heurea }}</small>
                                </td>
                                <td>{{ vol.compagnie }}</td>
                                <td>
                                    <span class="badge bg-primary">{{ vol.sg }}</span> /
                                    <span class="badge bg-success">{{ vol.vendu }}</span> /
                                    <span class="badge bg-warning">{{ vol.reserve }}</span>
                                </td>
                                <td>
                                    {% if vol.ouvert == 1 %}
                                        <span class="badge bg-success">Ouvert</span>
                                    {% else %}
                                        <span class="badge bg-danger">Fermé</span>
                                    {% endif %}
                                </td>
                                <td class="text-center">
                                    <div class="dropdown">
                                        <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Actions">
                                            <i class="bx bx-dots-vertical-rounded"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <a class="dropdown-item" href="{{ path('app_vol_show', {'seqvol': vol.seqvol}) }}">
                                                    <i class="bx bx-show me-2"></i>Détails
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" href="{{ path('app_vol_edit', {'seqvol': vol.seqvol}) }}">
                                                    <i class="bx bx-edit-alt me-2"></i>Modifier
                                                </a>
                                            </li>
                                            <li>
                                                {{ include('vol/_delete_form.html.twig', {
                                                    vol: vol,
                                                    btn_class: 'dropdown-item'
                                                }) }}
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="9" style="text-align: center">Aucun vol trouvé...</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %}