<style>
    /* ====== Cartes / sections ====== */
    .card {
        border-radius: 8px;
        box-shadow: 0 2px 4px rgba(0,0,0,.1);
        background-color: #fff;
        padding: 5px;
        margin-bottom: 8px;
    }
    .flight-section {
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 15px;
        height: 100%;
    }
    .departure-section { border-left: 4px solid #28a745; padding-left: 10px; }
    .arrival-section   { border-left: 4px solid #007bff; padding-left: 10px; }

    /* ====== Titres / labels / inputs ====== */
    .section-title { font-weight: 600; margin-bottom: 15px; display: block; }
    .form-check { margin-bottom: 10px; }

    /* Style générique des labels (hors floating) */
    :not(.form-group-legend) > .form-label {
        font-weight: 500;
        margin-bottom: 5px;
        color: #495057;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .form-label .required { color: #dc3545; margin-left: 5px; }

    /* Inputs génériques */
    .form-control, .form-select {
        border-radius: 4px;
        padding: 8px 12px;
        border: 1px solid #ced4da;
        margin-bottom: 2px;
    }

    /* ====== Stepper ====== */
    .step-progress{display:flex;justify-content:space-between;margin-bottom:30px;position:relative;}
    .step-progress::before{content:'';position:absolute;top:20px;left:0;right:0;height:3px;background-color:#e9ecef;z-index:1;}
    .step-progress-bar{position:absolute;top:20px;left:0;height:3px;background-color:#007bff;transition:all .3s ease;z-index:2;}
    .step{display:flex;flex-direction:column;align-items:center;position:relative;z-index:3;flex:1;}
    .step-circle{width:40px;height:40px;border-radius:50%;background-color:#e9ecef;color:#6c757d;display:flex;align-items:center;justify-content:center;font-weight:bold;margin-bottom:10px;border:3px solid #e9ecef;transition:all .3s ease;}
    .step.active .step-circle{background-color:#007bff;color:#fff;border-color:#007bff;}
    .step.completed .step-circle{background-color:#28a745;color:#fff;border-color:#28a745;}
    .step-label{font-size:.9rem;font-weight:500;text-align:center;color:#6c757d;}
    .step.active .step-label{color:#007bff;font-weight:bold;}
    .step.completed .step-label{color:#28a745;}
    .step-content{display:none;animation:fadeIn .5s ease-in;}
    .step-content.active{display:block;}
    .step-card{border-left:4px solid #007bff;}
    .step-card h3{
        color:#007bff;margin-bottom:20px;padding-bottom:10px;border-bottom:1px solid #dee2e6;background:#f8f9fa;border-radius:8px 8px 0 0;
    }
    @keyframes fadeIn{from{opacity:0;transform:translateY(20px);}to{opacity:1;transform:translateY(0);}}
    @media(max-width:768px){
        .col-md-3{margin-bottom:20px;}
        .step-progress{flex-direction:column;align-items:flex-start;}
        .step{flex-direction:row;margin-bottom:15px;width:100%;}
        .step-circle{margin-bottom:0;margin-right:15px;}
        .step-progress::before,.step-progress-bar{display:none;}
    }

    /* ====== Floating labels ====== */
    .form-group-legend{position:relative;margin-bottom:1rem;}
    .form-group-legend .form-control,
    .form-group-legend .form-select{
        font-size:.85rem;
        padding:.9rem .5rem .4rem .5rem; /* espace haut pour le label */
        border:1px solid #d0d7de;
        border-radius:6px;
        background:#fff;
    }
    .form-group-legend .form-label{
        position:absolute; top:-.6rem; left:.6rem;
        font-size:.75rem; font-weight:600;
        background:#fff; /* masque la bordure sous le label */
        padding:0 .25rem;
        color:#555; pointer-events:none; margin-bottom:0;
    }
    .form-group-legend .form-control:focus,
    .form-group-legend .form-select:focus{
        border-color:#009cc2; box-shadow:0 0 0 .15rem rgba(0,156,194,.25);
    }
    /* Erreurs dans floating */
    .form-group-legend .invalid-feedback{display:block;margin-top:.25rem;}
    .form-group-legend .is-invalid{border-color:#dc3545 !important;}

    /* ====== Sections spécifiques ====== */
    .engaged-seat{background-color:#0000cc;color:#fff;padding:10px;}
    .engaged-seat input{background-color:#fff;font-weight:bold;}
    .red-text{color:red;font-weight:bold;font-size:1.1rem;}

    /* Convocation look moderne */
    .convocation-card{
        /*background:linear-gradient(180deg,#eaf3ff 0%,#f6faff 100%);*/
        border:1px solid #cfe3ff;border-radius:12px;padding:16px;
    }
    .convocation-subtitle{color:#0d6efd;}
    .convocation-card .form-group-legend .form-label{background:#FFFFFF;} /* coupe la bordure avec le fond bleuté */

    /* Bandeau info + field */
    .info-inline{background:#fff7f7;border:1px dashed #f4b5b5;border-radius:10px;}
    .info-inline__text{color:#d90429;font-weight:600;flex:1 1 auto;min-width:260px;}
    .info-inline__field{flex:0 0 350px;} /* largeur accrue */
    @media (max-width:576px){ .info-inline__field{flex:1 1 100%;} }
    .info-inline .form-group-legend .form-label{background:#fff;} /* bandeau blanc */

    /* Petites tailles pour labels check */
    label.form-check-label.mb-0.required, label.form-check-label{font-size:13px;}
</style>

{% block body %}
    {{ form_start(form, {
        'attr': {'id':'vol-form','data-validate-url': path('app_vol_validate_tab')}
    }) }}

    <!-- Steps -->
    <div class="step-progress mb-5">
        <div class="step-progress-bar" style="width:0%;"></div>
        <div class="step active" data-step="0"><div class="step-circle">1</div><div class="step-label">Informations Générales</div></div>
        <div class="step" data-step="1"><div class="step-circle">2</div><div class="step-label">Capacités</div></div>
        <div class="step" data-step="2"><div class="step-circle">3</div><div class="step-label">Tarification</div></div>
        <div class="step" data-step="3"><div class="step-circle">4</div><div class="step-label">Convocation</div></div>
        <div class="step" data-step="4"><div class="step-circle">5</div><div class="step-label">Bagages</div></div>
    </div>

    <!-- Step 1 -->
    <div class="step-content active" data-step="0">
        <div class="card step-card">
            <h3><i class="fas fa-info-circle"></i> Informations Générales</h3>
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-group-legend">
                                    {{ form_widget(form.seqvol, {'attr': {'class':'form-control'}}) }}
                                    {{ form_label(form.seqvol, 'N° Séq.', {'label_attr': {'class':'form-label'}}) }}
                                    {{ form_errors(form.seqvol) }}
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group-legend">
                                    {{ form_widget(form.nvol, {'attr': {'class':'form-control'}}) }}
                                    {{ form_label(form.nvol, 'N° du vol', {'label_attr': {'class':'form-label'}}) }}
                                    {{ form_errors(form.nvol) }}
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group-legend">
                                    {{ form_widget(form.datevol, {'attr': {'class':'form-control bg-white'}}) }}
                                    {{ form_label(form.datevol, 'Date vol', {'label_attr': {'class':'form-label'}}) }}
                                    {{ form_errors(form.datevol) }}
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group-legend">
                                    {{ form_widget(form.jo, {'attr': {'class':'form-control bg-white','readonly':'readonly'}}) }}
                                    {{ form_label(form.jo, 'JO', {'label_attr': {'class':'form-label'}}) }}
                                    {{ form_errors(form.jo) }}
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-group-legend">
                                    {{ form_widget(form.jplus, {'attr': {'class':'form-control bg-white'}}) }}
                                    {{ form_label(form.jplus, 'J.Plus', {'label_attr': {'class':'form-label'}}) }}
                                    {{ form_errors(form.jplus) }}
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group-legend">
                                    {{ form_widget(form.pnr, {'attr': {'class':'form-control bg-white','placeholder':'Saisir le PNR'}}) }}
                                    {{ form_label(form.pnr, 'PNR', {'label_attr': {'class':'form-label'}}) }}
                                    {{ form_errors(form.pnr) }}
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group-legend">
                                    {{ form_widget(form.datRetro, {'attr': {'class':'form-control bg-white'}}) }}
                                    {{ form_label(form.datRetro, 'Délai rétro en jours', {'label_attr': {'class':'form-label'}}) }}
                                    {{ form_errors(form.datRetro) }}
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group-legend">
                                    {{ form_widget(form.destination, {'attr': {'class':'form-control bg-white'}}) }}
                                    {{ form_label(form.destination, 'Destination', {'label_attr': {'class':'form-label'}}) }}
                                    {{ form_errors(form.destination) }}
                                </div>
                            </div>
                        </div>

                        <div class="row align-items-center">
                            <div class="col-md-6 d-flex align-items-center">
                                {{ form_label(form.typevol, 'Type de vol', {'label_attr': {'class':'form-label fw-semibold me-2 mb-0'}}) }}
                                <div class="d-flex align-items-center">
                                    {% for child in form.typevol %}
                                        <div class="form-check form-check-inline mb-0 me-2">
                                            {{ form_widget(child, {'attr': {'class':'form-check-input'}}) }}
                                            {{ form_label(child, null, {'label_attr': {'class':'form-check-label mb-0'}}) }}
                                            {{ form_errors(child) }}
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                            <div class="col-md-6 d-flex align-items-center">
                                <div class="form-check form-switch mb-0">
                                    {{ form_widget(form.allotFreesale, {'attr': {'class':'form-check-input me-2'}}) }}
                                    {{ form_label(form.allotFreesale, 'Allotement free sale', {'label_attr': {'class':'form-check-label mb-0'}}) }}
                                    {{ form_errors(form.allotFreesale) }}
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Détails du vol -->
                <div class="col-md-12">
                    <div class="card">
                        <div class="row">
                            <!-- Départ -->
                            <div class="col-md-4">
                                <div class="flight-section departure-section">
                                    <span class="section-title text-success fw-bold">[Départ]</span>
                                    <div class="mb-1">
                                        <div class="form-group-legend">
                                            {{ form_widget(form.villeD, {'attr': {
                                                'class':'form-select form-select-sm ville-select-depart','id':'villeD','data-aero-target':'aerodep'
                                            }}) }}
                                            {{ form_label(form.villeD, 'Ville', {'label_attr': {'class':'form-label'}}) }}
                                            {{ form_errors(form.villeD) }}
                                        </div>
                                        <div class="form-group-legend">
                                            {{ form_widget(form.aerodep, {'attr': {
                                                'class':'form-control bg-white form-control-sm aerodep','id':'aerodep','readonly':true
                                            }}) }}
                                            {{ form_label(form.aerodep, 'Aéroport Départ', {'label_attr': {'class':'form-label'}}) }}
                                            {{ form_errors(form.aerodep) }}
                                        </div>
                                    </div>
                                    <div class="mb-1">
                                        <div class="form-group-legend">
                                            {{ form_widget(form.heured, {'attr': {
                                                'class':'form-control bg-white form-control-sm','data-aeroport-target':'timeInput'
                                            }}) }}
                                            {{ form_label(form.heured, 'Heure de départ', {'label_attr': {'class':'form-label'}}) }}
                                            {{ form_errors(form.heured) }}
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Arrivée -->
                            <div class="col-md-4">
                                <div class="flight-section arrival-section">
                                    <span class="section-title fw-bold">[Arrivée]</span>
                                    <div class="mb-1">
                                        <div class="form-group-legend">
                                            {{ form_widget(form.villeA, {'attr': {
                                                'class':'form-select form-select-sm ville-select','id':'villeA','data-aero-target':'aeroarr'
                                            }}) }}
                                            {{ form_label(form.villeA, 'Ville', {'label_attr': {'class':'form-label'}}) }}
                                            {{ form_errors(form.villeA) }}
                                        </div>
                                        <div class="form-group-legend">
                                            {{ form_widget(form.aeroarr, {'attr': {
                                                'class':'form-control bg-white form-control-sm aeroarr','id':'aeroarr','readonly':true
                                            }}) }}
                                            {{ form_label(form.aeroarr, 'Aéroport Arrivée', {'label_attr': {'class':'form-label'}}) }}
                                            {{ form_errors(form.aeroarr) }}
                                        </div>
                                    </div>
                                    <div class="mb-1">
                                        <div class="form-group-legend">
                                            {{ form_widget(form.heurea, {'attr': {
                                                'class':'form-control bg-white form-control-sm','data-aeroport-target':'timeInput'
                                            }}) }}
                                            {{ form_label(form.heurea, "Heure d'arrivée", {'label_attr': {'class':'form-label'}}) }}
                                            {{ form_errors(form.heurea) }}
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Via -->
                            <div class="col-md-4">
                                <div class="flight-section via-section">
                                    <span class="section-title text-warning fw-bold">[Via]</span>
                                    <div class="mb-1">
                                        <div class="form-group-legend">
                                            {{ form_widget(form.villeV, {'attr': {'class':'form-select form-select-sm'}}) }}
                                            {{ form_label(form.villeV, 'Ville Via', {'label_attr': {'class':'form-label'}}) }}
                                            {{ form_errors(form.villeV) }}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Options -->
                        <div class="row mt-4">
                            <div class="col-md-12">
                                <div class="form-check form-switch">
                                    {{ form_widget(form.volsec, {'attr': {'class':'form-check-input'}}) }}
                                    {{ form_label(form.volsec, 'Autorisé Vente Vol Sec Internet', {'label_attr': {'class':'form-check-label'}}) }}
                                    {{ form_errors(form.volsec) }}
                                </div>
                                <div class="form-check form-switch">
                                    {{ form_widget(form.bagagesoute, {'attr': {'class':'form-check-input'}}) }}
                                    {{ form_label(form.bagagesoute, '1 seul bag en soute / Passager', {'label_attr': {'class':'form-check-label'}}) }}
                                    {{ form_errors(form.bagagesoute) }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Affréteur -->
                <div class="col-md-12">
                    <div class="card shadow-sm border-0 mb-3" style="border-radius: 12px;">
                        <div class="card-header py-2" style="background:#f8f9fa;border-radius:12px 12px 0 0;">
                            <h6 class="mb-2 fw-bold text-dark" style="color:#007bff;">
                                <i class="fa fa-plane me-2"></i> Section Affréteur
                            </h6>
                        </div>
                        <div class="card-body mt-2">
                            <div class="row g-3 align-items-end">
                                <div class="col-md-1">
                                    <div class="form-group-legend">
                                        {{ form_widget(form.codaffret, {'attr': {
                                            'class':'form-select form-select-sm affret-select bg-white','id':'codaffret','data-lib-target':'libaffret'
                                        }}) }}
                                        {{ form_label(form.codaffret, 'Affréteur', {'label_attr': {'class':'form-label'}}) }}
                                        {{ form_errors(form.codaffret) }}
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group-legend">
                                        {{ form_widget(form.libaffret, {'attr': {
                                            'class':'form-control form-control-sm bg-white libaffret','id':'libaffret','readonly':true
                                        }}) }}
                                        {{ form_label(form.libaffret, 'Nom Affréteur', {'label_attr': {'class':'form-label'}}) }}
                                        {{ form_errors(form.libaffret) }}
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group-legend">
                                        {{ form_widget(form.nomfour, {'attr': {'class':'form-control form-control-sm bg-white'}}) }}
                                        {{ form_label(form.nomfour, 'Fournisseur', {'label_attr': {'class':'form-label'}}) }}
                                        {{ form_errors(form.nomfour) }}
                                    </div>
                                </div>
                                <div class="col-md-2 d-flex align-items-center mt-2">
                                    <div class="form-check form-switch mb-4">
                                        {{ form_widget(form.ferry, {'attr': {'class':'form-check-input me-2'}}) }}
                                        {{ form_label(form.ferry, 'Vol Ferry', {'label_attr': {'class':'form-check-label'}}) }}
                                        {{ form_errors(form.ferry) }}
                                    </div>
                                </div>
                                <div class="col-md-2 d-flex align-items-center mt-2">
                                    <div class="form-check form-switch mb-4">
                                        {{ form_widget(form.fictif, {'attr': {'class':'form-check-input me-2'}}) }}
                                        {{ form_label(form.fictif, 'Vol Fictif', {'label_attr': {'class':'form-check-label'}}) }}
                                        {{ form_errors(form.fictif) }}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div> <!-- row -->
        </div>
    </div>

    <!-- Step 2 -->
    <div class="step-content" data-step="1">
        <div class="card step-card">
            <h3><i class="fas fa-chart-bar"></i> Capacités</h3>
            <div class="row">
                <div class="col-md-4">
                    <div class="col-md-12 card card-body shadow-sm" style="border-radius:8px;height:fit-content;">
                        <div class="col-md-12">
                            <div class="form-group-legend">
                                {{ form_widget(form.ouvert, {'attr': {
                                    'class':'form-control bg-white','data-action':'change->availability#calculateAvailability',
                                    'data-availability-ouvert-value': form.ouvert.vars.value|default(0)
                                }}) }}
                                {{ form_label(form.ouvert, 'Offre Total', {'label_attr': {'class':'form-label'}}) }}
                                {{ form_errors(form.ouvert) }}
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group-legend">
                                {{ form_widget(form.vendu, {'attr': {'class':'form-control bg-white calc-field','id':'vendu-field','data-calc':'vendu'}}) }}
                                {{ form_label(form.vendu, 'Vendu', {'label_attr': {'class':'form-label'}}) }}
                                {{ form_errors(form.vendu) }}
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group-legend">
                                {{ form_widget(form.reserve, {'attr': {'class':'form-control bg-white calc-field','id':'reserve-field','data-calc':'reserve'}}) }}
                                {{ form_label(form.reserve, 'Réservé', {'label_attr': {'class':'form-label'}}) }}
                                {{ form_errors(form.reserve) }}
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group-legend">
                                {{ form_widget(form.freesale, {'attr': {'class':'form-control bg-white'}}) }}
                                {{ form_label(form.freesale, 'Free Sale', {'label_attr': {'class':'form-label'}}) }}
                                {{ form_errors(form.freesale) }}
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group-legend">
                                {{ form_widget(form.dispo, {'attr': {'class':'form-control bg-white bg-light','readonly':true,'id':'dispo-field','data-calc':'dispo'}}) }}
                                {{ form_label(form.dispo, 'Dispo.', {'label_attr': {'class':'form-label'}}) }}
                                {{ form_errors(form.dispo) }}
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group-legend">
                                {{ form_widget(form.blocsiege, {'attr': {'class':'form-control bg-white'}}) }}
                                {{ form_label(form.blocsiege, 'Blocsiege', {'label_attr': {'class':'form-label'}}) }}
                                {{ form_errors(form.blocsiege) }}
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-8">
                    <div class="card card-body shadow-sm" style="border-radius:8px; height:fit-content;">

                        <!-- Ligne 1 : SG + switch -->
                        <div class="row g-3 align-items-end">
                            <div class="col-md-3">
                                <div class="form-group-legend">
                                    {{ form_widget(form.sg, {'attr': {'class': 'form-control bg-white'}}) }}
                                    {{ form_label(form.sg, "Siège(s) engagé(s)", {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_errors(form.sg) }}
                                </div>
                            </div>

                            <div class="col-md-9 d-flex align-items-center">
                                <div class="form-check form-switch mb-4">
                                    {{ form_widget(form.venduVolsec, {'attr': {'class':'form-check-input me-2'}}) }}
                                    {{ form_label(form.venduVolsec, 'Autorisé uniquement 7 jours Vente Vol Sec Pour Internet', {'label_attr': {'class':'form-check-label mb-0'}}) }}
                                    {{ form_errors(form.venduVolsec) }}
                                </div>
                            </div>
                        </div>

                        <!-- Ligne 2 : Date de confirmation -->
                        <div class="row g-3 mt-2">
                            <div class="col-md-4">
                                <div class="form-group-legend">
                                    {{ form_widget(form.datedeconf, {'attr': {'class':'form-control bg-white'}}) }}
                                    {{ form_label(form.datedeconf, 'Date de confirmation', {'label_attr': {'class':'form-label'}}) }}
                                    {{ form_errors(form.datedeconf) }}
                                </div>
                            </div>
                        </div>

                        <!-- Ligne 3 : Observations -->
                        <div class="row g-3 mt-1">
                            <div class="col-12">
                                <div class="form-group-legend">
                                    {{ form_widget(form.obs, {'attr': {'class':'form-control bg-white'}}) }}
                                    {{ form_label(form.obs, "Observations", {'label_attr': {'class':'form-label'}}) }}
                                    {{ form_errors(form.obs) }}
                                </div>
                            </div>
                        </div>

                    </div>
                </div>


            </div> <!-- row -->
        </div>
    </div>

    <!-- Step 3 -->
    <div class="step-content" data-step="2">
        <div class="card step-card">
            <h3><i class="fas fa-tags"></i> Tarification</h3>
            <div class="col-md-12 card card-body shadow-sm">
                <div class="row">
                    <div class="col-md-8">
                        <table class="table table-bordered text-center align-middle shadow-sm mb-4">
                            <thead class="table-primary">
                            <tr><th colspan="6" class="text-center fs-5 fw-bold">Tarification</th></tr>
                            <tr><th>Tarification</th><th>Adulte</th><th>Enfant</th><th>Bébé</th><th>Taxe</th></tr>
                            </thead>
                            <tbody>
                            <tr>
                                <th class="align-middle fw-bold text-center">Achat forfait</th>
                                <td>{{ form_widget(form.prixada,  {'attr': {'class':'form-control form-control-sm'}}) }}</td>
                                <td>{{ form_widget(form.prixzza,  {'attr': {'class':'form-control form-control-sm'}}) }}</td>
