<style>

	.form-field {
		display: flex;
		align-items: center;
		margin-bottom: 12px;
		width: 100%;
	}


	.form-label {
		min-width: 180px;
		margin-right: 15px;
		text-align: left;
		white-space: nowrap;
	}


	.form-input {
		flex: 1;
	}
	.form-control {
		background-color: white !important;
	}
	.engaged-seat {
		background-color: #0000cc;
		color: white;
		padding: 10px;
	}

	.engaged-seat input {
		background-color: yellow;
		font-weight: bold;
	}

	.red-text {
		color: red;
		font-weight: bold;
		font-size: 1.1rem;
	}

	.highlight-yellow {
		background-color: yellow;
	}

	.label-bold {
		font-weight: bold;
	}


	.section-yield {
		background-color: cyan;
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 5px 10px;
		font-weight: bold;
	}

	.section-yield input {
		width: 80px;
		font-size: 0.9rem;
		padding: 2px 4px;
	}

	.section-freesale {
		background-color: red;
		color: white;
		text-align: center;
		font-weight: bold;
		padding: 5px;
	}

	.section-stop-sale {
		background-color: magenta;
		text-align: center;
		padding: 10px;
	}

	.section-stop-sale button {
		background-color: white;
		border: 1px solid #ccc;
		font-weight: bold;
		padding: 3px 8px;
		cursor: pointer;
	}
</style>
