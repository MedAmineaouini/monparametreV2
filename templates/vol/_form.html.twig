                                        {{ form_errors(form.villeD) }}
                                    </div>
                                    <div class="form-group-legend">
                                        {{ form_widget(form.aerodep, {'attr': {
                                            'class':'form-control bg-white form-control-sm aerodep',
                                            'id':'aerodep',
                                            'readonly':true
                                        }}) }}
                                        {{ form_label(form.aerodep, 'Aéroport Départ:', {'label_attr': {'class':'form-label'}}) }}
                                        {{ form_errors(form.aerodep) }}
                                    </div>
                                </div>
                                <div class="mb-1">
                                    <div class="form-group-legend">
                                        {{ form_widget(form.heured, {'attr': {
                                            'class':'form-control bg-white form-control-sm',
                                            'data-aeroport-target':'timeInput'
                                        }}) }}
                                        {{ form_label(form.heured, 'Heure de départ:', {'label_attr': {'class':'form-label'}}) }}
                                        {{ form_errors(form.heured) }}
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Arrivée -->
