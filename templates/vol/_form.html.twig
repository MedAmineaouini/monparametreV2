{#                        <div class="col-md-12">#}
{#                            <div class="form-check form-switch">#}
{#                                {{ form_widget(form.volsec, {'attr': {'class':'form-check-input'}}) }}#}
{#                                {{ form_label(form.volsec, 'Autorisé Vente Vol Sec Internet', {'label_attr': {'class':'form-check-label'}}) }}#}
{#                                {{ form_errors(form.volsec) }}#}
{#                            </div>#}
