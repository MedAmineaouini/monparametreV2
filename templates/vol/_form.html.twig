<script>
$(document).ready(function() {
    let currentTab = 0;
    const tabs = $('.tab-pane');
    const tabButtons = $('#volTabs .nav-link');
    const nextBtn = $('#nextBtn');
    const prevBtn = $('#prevBtn');
    const submitBtn = $('#submitBtn');
    const form = $('#vol-form');

    function showTab(index) {
        tabs.removeClass('show active').eq(index).addClass('show active');
        tabButtons.removeClass('active').eq(index).addClass('active');
        
        if (index === 0) {
            prevBtn.hide();
        } else {
            prevBtn.show();
        }
        
        if (index === tabs.length - 1) {
            nextBtn.hide();
            submitBtn.show();
        } else {
            nextBtn.show();
            submitBtn.hide();
        }
        
        currentTab = index;
    }

    // nextBtn.click(function() {
    //     saveFormData();
    // });
    nextBtn.click(function() {
    if (currentTab < tabs.length - 1) {
        showTab(currentTab + 1);
    }
    });

    prevBtn.click(function() {
        if (currentTab > 0) {
            showTab(currentTab - 1);
        }
    });

    submitBtn.click(function() {
        form.submit();
    }); 
    function setupVilleSelect(selector, inputClass, urlPrefix) {
        $(selector).on('change', function() {
            const villeId = $(this).val();
            if (!villeId) {
                $('.' + inputClass).val('');
                return;
            }
            $.ajax({
                url: urlPrefix + villeId,
                type: 'GET',
                dataType: 'json',
                success: function(data) {
                    $('.' + inputClass).val(data.aeroport || '');
                },
                error: function() {
                    $('.' + inputClass).val('');
                }
            });
        });
        $(selector).trigger('change');
    }
    function setupAffretSelect() {
        $('.affret-select').on('change', function() {
            const affretId = $(this).val();
            const libaffretField = $('.libaffret');
            
            if (!affretId) {
                libaffretField.val('');
                return;
            }
            
            libaffretField.val('Chargement...');
            
            $.ajax({
                url: '/vol/get-affret/' + affretId,
                type: 'GET',
                dataType: 'json',
                success: function(data) {
                    libaffretField.val(data.libaffret || 'Non trouvé');
                },
                error: function() {
                    libaffretField.val('Erreur de chargement');
                    console.error("Erreur lors du chargement de l'affréteur");
                }
            });
        }).trigger('change');
    }


    function calculateDispo() {
        const vendu = parseInt($('[data-calc="vendu"]').val()) || 0;
        const reserve = parseInt($('[data-calc="reserve"]').val()) || 0;
        const dispo = Math.max(0, vendu - reserve);
        
        $('[data-calc="dispo"]').val(dispo);
    }
    setupVilleSelect('.ville-select', 'aeroarr', '/vol/get-aeroport/');
    setupVilleSelect('.ville-select-depart', 'aerodep', '/vol/get-aeroport/');
    setupAffretSelect();
    
    $('[data-calc="vendu"], [data-calc="reserve"]').on('input', calculateDispo);
    calculateDispo();
});

function saveFormData() {
    const formData = new FormData(document.getElementById('vol-form'));
    
    $.ajax({
        url: $('#vol-form').attr('action'),
        type: 'POST',
        data: formData,
        processData: false,
        contentType: false,
        success: function(response) {
            if (response.success) {
                if (currentTab < tabs.length - 1) {
                    showTab(currentTab + 1);
                }
            } else {
                // Afficher les erreurs
                if (response.errors) {
                    // Supprimer les anciennes erreurs
                    $('.error-message').remove();
                    
                    // Afficher les nouvelles erreurs
                    for (const field in response.errors) {
                        const errorElement = $(`[name="${field}"]`);
                        errorElement.after(`<div class="error-message text-danger">${response.errors[field]}</div>`);
                        errorElement.addClass('is-invalid');
                    }
                }
            }
        },
        error: function(xhr) {
            console.error('Error:', xhr.responseText);
            alert('Une erreur est survenue: ' + xhr.responseText);
        }
    });
}
</script>


