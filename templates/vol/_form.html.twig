<style>
    /* ===== VARIABLES ET CONFIGURATION GÉNÉRALE ===== */
    :root {
        --primary-color: #007bff;
        --success-color: #28a745;
        --danger-color: #dc3545;
        --border-radius: 8px;
        --box-shadow: 0 2px 4px rgba(0,0,0,.1);
        --transition: all .3s ease;
    }

    /* ===== COMPOSANTS RÉUTILISABLES ===== */
    .card {
        border-radius: var(--border-radius);
        box-shadow: var(--box-shadow);
        background-color: #fff;
        padding: 5px;
        margin-bottom: 8px;
    }

    .flight-section {
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 15px;
        height: 100%;
    }

    .departure-section {
        border-left: 4px solid var(--success-color);
        padding-left: 10px;
    }

    .arrival-section {
        border-left: 4px solid var(--primary-color);
        padding-left: 10px;
    }

    .via-section {
        border-left: 4px solid #ffc107;
        padding-left: 10px;
    }

    /* ===== TYPOGRAPHIE ET FORMULAIRES ===== */
    .section-title {
        font-weight: 600;
        margin-bottom: 15px;
        display: block;
    }

    .form-check {
        margin-bottom: 10px;
    }

    /* Labels génériques */
    :not(.form-group-legend) > .form-label {
        font-weight: 500;
        margin-bottom: 5px;
        color: #495057;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .form-label .required {
        color: var(--danger-color);
        margin-left: 5px;
    }

    /* Champs de formulaire */
    .form-control, .form-select {
        border-radius: 4px;
        padding: 8px 12px;
        border: 1px solid #ced4da;
        margin-bottom: 2px;
    }

    /* ===== COMPOSANT STEPPER ===== */
    .step-progress {
        display: flex;
        justify-content: space-between;
        margin-bottom: 30px;
        position: relative;
    }

    .step-progress::before {
        content: '';
        position: absolute;
        top: 20px;
        left: 0;
        right: 0;
        height: 3px;
        background-color: #e9ecef;
        z-index: 1;
    }

    .step-progress-bar {
        position: absolute;
        top: 20px;
        left: 0;
        height: 3px;
        background-color: var(--primary-color);
        transition: var(--transition);
        z-index: 2;
    }

    .step {
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        z-index: 3;
        flex: 1;
    }

    .step-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background-color: #e9ecef;
        color: #6c757d;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        margin-bottom: 10px;
        border: 3px solid #e9ecef;
        transition: var(--transition);
    }

    .step.active .step-circle {
        background-color: var(--primary-color);
        color: #fff;
        border-color: var(--primary-color);
    }

    .step.completed .step-circle {
        background-color: var(--success-color);
        color: #fff;
        border-color: var(--success-color);
    }

    .step-label {
        font-size: .9rem;
        font-weight: 500;
        text-align: center;
        color: #6c757d;
    }

    .step.active .step-label {
        color: var(--primary-color);
        font-weight: bold;
    }

    .step.completed .step-label {
        color: var(--success-color);
    }

    .step-content {
        display: none;
        animation: fadeIn .5s ease-in;
    }

    .step-content.active {
        display: block;
    }

    .step-card {
        border-left: 4px solid var(--primary-color);
    }

    .step-card h3 {
        color: var(--primary-color);
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 1px solid #dee2e6;
        background: #f8f9fa;
        border-radius: 8px 8px 0 0;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* ===== LABELS FLOTTANTS ===== */
    .form-group-legend {
        position: relative;
        margin-bottom: 1rem;
    }

    .form-group-legend .form-control,
    .form-group-legend .form-select {
        font-size: .85rem;
        padding: .3rem .4rem;
        border: 1px solid #d0d7de;
        border-radius: 6px;
        background: #fff;
    }

    .form-group-legend .form-label {
        position: absolute;
        top: -.6rem;
        left: .6rem;
        font-size: .75rem;
        font-weight: 600;
        background: #fff;
        padding: 0 .25rem;
        color: #555;
        pointer-events: none;
        margin-bottom: 0;
    }

    .form-group-legend .form-control:focus,
    .form-group-legend .form-select:focus {
        border-color: #009cc2;
        box-shadow: 0 0 0 .15rem rgba(0,156,194,.25);
    }

    /* États de validation */
    .form-group-legend .invalid-feedback {
        display: block;
        margin-top: .25rem;
    }

    .form-group-legend .is-invalid {
        border-color: var(--danger-color) !important;
    }

    /* ===== SECTIONS SPÉCIFIQUES ===== */
    .engaged-seat {
        background-color: #0000cc;
        color: #fff;
        padding: 10px;
    }

    .engaged-seat input {
        background-color: #fff;
        font-weight: bold;
    }

    .red-text {
        color: var(--danger-color);
        font-weight: bold;
        font-size: 1.1rem;
    }

    /* Carte de convocation */
    .convocation-card {
        border: 1px solid #cfe3ff;
        border-radius: 12px;
        padding: 16px;
    }

    .convocation-subtitle {
        color: var(--primary-color);
    }

    .convocation-card .form-group-legend .form-label {
        background: #FFFFFF;
    }

    /* Bandeau d'information */
    .info-inline {
        background: #fff7f7;
        border: 1px dashed #f4b5b5;
        border-radius: 10px;
    }

    .info-inline__text {
        color: #d90429;
        font-weight: 600;
        flex: 1 1 auto;
        min-width: 260px;
    }

    .info-inline__field {
        flex: 0 0 350px;
    }

    .info-inline .form-group-legend .form-label {
        background: #fff;
    }

    /* Labels de checkbox */
    label.form-check-label.mb-0.required,
    label.form-check-label {
        font-size: 13px;
    }

    /* ===== UTILITAIRES ===== */
    .vertical-text {
        writing-mode: vertical-lr;
        transform: rotate(180deg);
        display: inline-block;
        white-space: nowrap;
    }

    .table th {
        font-weight: 600;
    }

    .form-control-sm {
        min-height: 32px;
        padding: 0.25rem 0.5rem;
    }

    .bg-light {
        background-color: #f8f9fa !important;
    }

    .border-dark {
        border-color: #dee2e6 !important;
    }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 768px) {
        .col-md-3 {
            margin-bottom: 20px;
        }

        .step-progress {
            flex-direction: column;
            align-items: flex-start;
        }

        .step {
            flex-direction: row;
            margin-bottom: 15px;
            width: 100%;
        }

        .step-circle {
            margin-bottom: 0;
            margin-right: 15px;
        }

        .step-progress::before,
        .step-progress-bar {
            display: none;
        }
    }

    @media (max-width: 576px) {
        .info-inline__field {
            flex: 1 1 100%;
        }
    }
</style>

{% block body %}
    {{ form_start(form, {
        'attr': {
            'id':'vol-form',
            'data-validate-url': path('app_vol_validate_tab')
        }
    }) }}

    <!-- Stepper de navigation -->
    <div class="step-progress mb-5">
        <div class="step-progress-bar" style="width:0%;"></div>
        <div class="step active" data-step="0">
            <div class="step-circle">1</div>
            <div class="step-label">Informations Générales</div>
        </div>
        <div class="step" data-step="1">
            <div class="step-circle">2</div>
            <div class="step-label">Capacités</div>
        </div>
        <div class="step" data-step="2">
            <div class="step-circle">3</div>
            <div class="step-label">Tarification</div>
        </div>
        <div class="step" data-step="3">
            <div class="step-circle">4</div>
            <div class="step-label">Convocation</div>
        </div>
        <div class="step" data-step="4">
            <div class="step-circle">5</div>
            <div class="step-label">Bagages</div>
        </div>
    </div>

    <!-- Étape 1: Informations Générales -->
    <div class="step-content active" data-step="0">
        <div class="card step-card">
            <h4 style="color: #007bff"><i class="fas fa-info-circle"></i> Informations Générales</h4>

            <!-- Informations de base du vol -->
            <div class="col-md-12">
                <div class="card">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group-legend">
                                {{ form_widget(form.seqvol, {'attr': {'class':'form-control'}}) }}
                                {{ form_label(form.seqvol, 'N° Séq:', {'label_attr': {'class':'form-label'}}) }}
                                {{ form_errors(form.seqvol) }}
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group-legend">
                                {{ form_widget(form.nvol, {'attr': {'class':'form-control'}}) }}
                                {{ form_label(form.nvol, 'N° du vol:', {'label_attr': {'class':'form-label'}}) }}
                                {{ form_errors(form.nvol) }}
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group-legend">
                                {{ form_widget(form.datevol, {'attr': {
                                    'class': 'form-control bg-white date-start',
                                    'min': 'now'|date('Y-m-d'),
                                    'value': 'now'|date('Y-m-d')
                                }}) }}
                                {{ form_label(form.datevol, 'Date vol :', {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_errors(form.datevol) }}
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group-legend">
                                {{ form_widget(form.jo, {'attr': {
                                    'class': 'form-control bg-white day-of-week',
                                    'readonly': 'readonly'
                                }}) }}
                                {{ form_label(form.jo, 'JO (Jour):', {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_errors(form.jo) }}
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group-legend">
                                {{ form_widget(form.datevolau, {'attr': {
                                    'class': 'form-control bg-white date-end',
                                    'min': form.datevol.vars.value ? form.datevol.vars.value|date('Y-m-d') : 'now'|date('Y-m-d')
                                }}) }}
                                {{ form_label(form.datevolau, 'Derniere date de la chaine :', {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_errors(form.datevolau) }}
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group-legend">
                                {{ form_widget(form.jplus, {'attr': {'class':'form-control bg-white'}}) }}
                                {{ form_label(form.jplus, 'J.Plus:', {'label_attr': {'class':'form-label'}}) }}
                                {{ form_errors(form.jplus) }}
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group-legend">
                                {{ form_widget(form.pnr, {'attr': {'class':'form-control bg-white','placeholder':'Saisir le PNR'}}) }}
                                {{ form_label(form.pnr, 'PNR:', {'label_attr': {'class':'form-label'}}) }}
                                {{ form_errors(form.pnr) }}
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group-legend">
                                {{ form_widget(form.retro_vol, {'attr': {'class':'form-control bg-white','placeholder':'Delais '}}) }}
                                {{ form_label(form.retro_vol, 'Délais rétro en jours:', {'label_attr': {'class':'form-label'}}) }}
                                {{ form_errors(form.retro_vol) }}
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group-legend">
                                {{ form_widget(form.datRetro, {'attr': {'class':'form-control bg-white'}}) }}
                                {{ form_label(form.datRetro, 'Date rétro:', {'label_attr': {'class':'form-label'}}) }}
                                {{ form_errors(form.datRetro) }}
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group-legend">
                                {{ form_label(form.IDPAYS, 'Destination:', {'label_attr': {'class':'form-label'}}) }}
                                {{ form_widget(form.IDPAYS, {'attr': {
                                    'class':'form-control bg-white destination_select',
                                    'id': 'destination_select'
                                }}) }}
                                {{ form_errors(form.IDPAYS) }}
                            </div>
                        </div>
                    </div>

                    <!-- Type de vol et options -->
                    <div class="row align-items-center">
                        <div class="col-md-3 d-flex align-items-center">
                            {{ form_label(form.typevol, 'Type de vol:', {'label_attr': {'class':'form-label fw-semibold me-2 mb-0'}}) }}
                            <div class="d-flex align-items-center">
                                {% for child in form.typevol %}
                                    <div class="form-check form-check-inline mb-0 me-2">
                                        {{ form_widget(child, {'attr': {'class':'form-check-input'}}) }}
                                        {{ form_label(child, null, {'label_attr': {'class':'form-check-label mb-0'}}) }}
                                        {{ form_errors(child) }}
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                        <div class="col-md-3 d-flex align-items-center">
                            <div class="form-check form-switch mb-0">
                                {{ form_widget(form.allotFreesale, {'attr': {'class':'form-check-input me-2'}}) }}
                                {{ form_label(form.allotFreesale, 'Allotement free sale', {'label_attr': {'class':'form-check-label mb-0'}}) }}
                                {{ form_errors(form.allotFreesale) }}
                            </div>
                        </div>
                        <div class="col-md-3 d-flex align-items-center">
                            <div class="form-check form-switch mb-0">
                                {{ form_widget(form.volsec, {'attr': {'class':'form-check-input'}}) }}
                                {{ form_label(form.volsec, 'Autorisé Vente Vol Sec Internet', {'label_attr': {'class':'form-check-label'}}) }}
                                {{ form_errors(form.volsec) }}
                            </div>
                        </div>
                        <div class="col-md-3 d-flex align-items-center">
                            <div class="form-check form-switch mb-0">
                                {{ form_widget(form.bagagesoute, {'attr': {'class':'form-check-input'}}) }}
                                {{ form_label(form.bagagesoute, '1 seul bag en soute / Passager', {'label_attr': {'class':'form-check-label'}}) }}
                                {{ form_errors(form.bagagesoute) }}
                            </div>
                        </div>
                    </div>
                    <div class="row g-3 align-items-end mt-2">
                        <div class="col-md-2">
                            <div class="form-group-legend">
                                {{ form_widget(form.codaffret, {'attr': {
                                    'class':'form-select form-select-sm affret-select bg-white',
                                    'id':'codaffret',
                                    'data-lib-target':'libaffret'
                                }}) }}
                                {{ form_label(form.codaffret, 'Affréteur:', {'label_attr': {'class':'form-label'}}) }}
                                {{ form_errors(form.codaffret) }}
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group-legend">
                                {{ form_widget(form.libaffret, {'attr': {
                                    'class':'form-control form-control-sm bg-white libaffret',
                                    'id':'libaffret',
                                    'readonly':true
                                }}) }}
                                {{ form_label(form.libaffret, 'Nom Affréteur:', {'label_attr': {'class':'form-label'}}) }}
                                {{ form_errors(form.libaffret) }}
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group-legend">
                                {{ form_widget(form.nomfour, {'attr': {'class':'form-control form-control-sm bg-white'}}) }}
                                {{ form_label(form.nomfour, 'Fournisseur:', {'label_attr': {'class':'form-label'}}) }}
                                {{ form_errors(form.nomfour) }}
                            </div>
                        </div>
                        <div class="col-md-1 d-flex align-items-center mt-2">
                            <div class="form-check form-switch mb-4">
                                {{ form_widget(form.ferry, {'attr': {'class':'form-check-input me-2'}}) }}
                                {{ form_label(form.ferry, 'Vol Ferry', {'label_attr': {'class':'form-check-label'}}) }}
                                {{ form_errors(form.ferry) }}
                            </div>
                        </div>
                        <div class="col-md-1 d-flex align-items-center mt-2">
                            <div class="form-check form-switch mb-4">
                                {{ form_widget(form.fictif, {'attr': {'class':'form-check-input me-2'}}) }}
                                {{ form_label(form.fictif, 'Vol Fictif', {'label_attr': {'class':'form-check-label'}}) }}
                                {{ form_errors(form.fictif) }}
                            </div>
                        </div>
                        <div class="col-md-2 d-flex align-items-center mt-2">
                            <div class="form-check form-switch mb-1">
                                <h6 class="form-check-label d-none" for="msg1" style="color: red;font-weight: bold">Retrocédé</h6>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Détails du vol: Départ, Arrivée, Via -->
            <div class="col-md-12">
                <div class="card">
                    <div class="row">
                        <!-- Départ -->
                        <div class="col-md-4">
                            <div class="flight-section departure-section">
                                <span class="section-title text-success fw-bold">[Départ]</span>
                                <div class="mb-1">
                                    <div class="form-group-legend">
                                        {{ form_widget(form.villeD, {'attr': {
                                            'class':'form-select form-select-sm ville-select-depart villed',
                                            'id':'villeD',
                                            'data-aero-target':'aerodep'
                                        }}) }}
