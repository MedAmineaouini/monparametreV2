{#                                {{ form_label(form.bagagesoute, '1 seul bag en soute / Passager', {'label_attr': {'class':'form-check-label'}}) }}#}
{#                                {{ form_errors(form.bagagesoute) }}#}
{#                            </div>#}
{#                        </div>#}
{#                    </div>#}
                </div>
            </div>

            <!-- Section Affréteur -->
            <div class="col-md-12">
                <div class="card shadow-sm border-1 mb-3" style="border: 1px solid #9a9c9d;border-radius: 12px;">
                    <div class="card-header py-2" style="background:#f8f9fa;border-radius:12px 12px 0 0;">
                        <h4 class="mb-2   step-card" style="color:#007bff;">
                            <i class="fas fa-chart-bar"></i> Capacités
                        </h4>
                    </div>
                    <div class="card-body mt-2">
                        <div class="row g-3 align-items-end"> {# g-3 pour l'espacement, align-items-end pour aligner en bas #}
                            <div class="col-auto"> {# col-auto pour largeur automatique #}
                                <div class="form-group-legend">
                                    {{ form_label(form.ouvert, 'Offre Total:', {'label_attr': {'class':'form-label'}}) }}
