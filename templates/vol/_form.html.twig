		padding: 5px 10px;
		font-weight: bold;
	}

	.section-yield input {
		width: 80px;
		font-size: 0.9rem;
		padding: 2px 4px;
	}

	.section-freesale {
		background-color: red;
		color: white;
		text-align: center;
		font-weight: bold;
		padding: 5px;
	}

	.section-stop-sale {
		background-color: magenta;
		text-align: center;
		padding: 10px;
	}

	.section-stop-sale button {
		background-color: white;
		border: 1px solid #ccc;
		font-weight: bold;
		padding: 3px 8px;
		cursor: pointer;
	}
