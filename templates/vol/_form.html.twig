    <!-- Script de gestion du formulaire -->
    <script>
        // Gestion de la navigation entre les étapes
        $(document).ready(function(){
            let currentStep = 0;
            const totalSteps = 5;
            const steps = $('.step');
            const stepContents = $('.step-content');
            const nextBtn = $('#nextBtn');
            const prevBtn = $('#prevBtn');
            const submitBtn = $('#submitBtn');
            const progressBar = $('.step-progress-bar');
            const formEl = $('#vol-form');

            // Affiche une étape spécifique
            function showStep(stepIndex){
                stepContents.removeClass('active');
                steps.removeClass('active completed');
                stepContents.eq(stepIndex).addClass('active');
                steps.eq(stepIndex).addClass('active');

                // Marquer les étapes précédentes comme complétées
                for(let i=0;i<stepIndex;i++){
                    steps.eq(i).addClass('completed');
                }

                // Mettre à jour la barre de progression
                const progress = (stepIndex/(totalSteps-1))*100;
                progressBar.css('width', progress + '%');

                // Gérer la visibilité des boutons
                if(stepIndex===0){
                    prevBtn.hide();
                } else {
                    prevBtn.show();
                }

                if(stepIndex===totalSteps-1){
                    nextBtn.hide();
                    submitBtn.show();
                } else {
                    nextBtn.show();
                    submitBtn.hide();
                }

                currentStep = stepIndex;
                $('html,body').animate({scrollTop: $('.step-progress').offset().top - 20}, 300);
            }

            // Validation côté client d'une étape
            function validateStepClient(stepIndex){
                let isValid = true;
                const errors = {};
                const currentStepContent = stepContents.eq(stepIndex);
                const requiredFields = currentStepContent.find('[required]');

                requiredFields.each(function(){
                    const $f = $(this);
                    const name = $f.attr('name') || $f.attr('id') || 'field';
                    if(!$f.val() || $f.val().toString().trim()===''){
                        isValid = false;
                        errors[name] = 'Ce champ est obligatoire';
                    }
                });

                return { valid:isValid, errors };
            }

            // Afficher les erreurs de validation
            function showValidationErrors(errors){
                $('.is-invalid').removeClass('is-invalid');
                $('.invalid-feedback').remove();

                for(const k in errors){
                    let $field = $(`[name="${k}"]`);
                    if($field.length===0){
                        $field = $(`[name="form[${k}]"]`);
                    }

                    if($field.length>0){
                        $field.addClass('is-invalid');
                        const $err = $('<div>').addClass('invalid-feedback').text(errors[k]);
                        $field.after($err);
                    }
                }

                const $first = $('.is-invalid').first();
                if($first.length>0){
                    $('html,body').animate({scrollTop: $first.offset().top - 100}, 500);
                }
            }

            // Événements de navigation
            nextBtn.on('click', function(){
                const res = validateStepClient(currentStep);
                if(res.valid){
                    if(currentStep<totalSteps-1){
                        showStep(currentStep+1);
                    }
                } else {
                    showValidationErrors(res.errors);
                }
            });

            prevBtn.on('click', function(){
                if(currentStep>0){
                    showStep(currentStep-1);
                }
            });

            steps.on('click', function(){
                const s = parseInt($(this).data('step'));
                if(s <= currentStep){
                    showStep(s);
                }
            });

            // Validation finale du formulaire
            formEl.on('submit', function(e){
                e.preventDefault();
                let allValid = true;
                const allErrors = {};

                for(let i=0;i<totalSteps;i++){
                    const r = validateStepClient(i);
                    if(!r.valid){
                        allValid=false;
                        Object.assign(allErrors, r.errors);
                        if(i!==currentStep){
                            showStep(i);
                        }
                        break;
                    }
                }

                if(allValid){
                    formEl.off('submit').submit();
                } else {
                    showValidationErrors(allErrors);
                    alert('Veuillez corriger les erreurs avant de soumettre.');
                }
            });

            // Configuration des sélecteurs de ville
            function setupVilleSelect(selector, inputClass, urlPrefix){
                $(selector).on('change', function(){
                    const villeId = $(this).val();
                    if(!villeId){
                        $('.'+inputClass).val('');
                        return;
                    }

                    $.ajax({
                        url: urlPrefix + villeId,
                        type:'GET',
                        dataType:'json',
                        success: function(data){
                            $('.'+inputClass).val(data.aeroport || '');
                        },
                        error: function(){
                            $('.'+inputClass).val('');
                        }
                    });
                }).trigger('change');
            }

            // Configuration du sélecteur d'affréteur
            function setupAffretSelect(){
                $('.affret-select').on('change', function(){
                    const id = $(this).val();
                    const $lib = $('.libaffret');
                    if(!id){
                        $lib.val('');
                        return;
                    }

                    $lib.val('Chargement...');
                    $.ajax({
                        url: '/vol/get-affret/' + id,
                        type:'GET',
                        dataType:'json',
                        success: function(data){
                            $lib.val(data.libaffret || 'Non trouvé');
                        },
                        error: function(){
                            $lib.val('Erreur de chargement');
                            console.error('Erreur chargement affréteur');
                        }
                    });
                }).trigger('change');
            }

            // Calcul de la disponibilité
            function calculateDispo(){
                const ouvert = parseInt($('[data-calc="ouvert"]').val()) || 0;
                const vendu = parseInt($('[data-calc="vendu"]').val()) || 0;
                const reserve = parseInt($('[data-calc="reserve"]').val()) || 0;
                const dispo = Math.max(0, ouvert - vendu - reserve);
                $('[data-calc="dispo"]').val(dispo);
            }

            // Calcul de la date rétro
            function calculateDateRetro() {
                try {
                    const retroVol = parseInt($('#{{ form.retro_vol.vars.id }}').val()) || 0;
                    const dateVol = $('#{{ form.datevol.vars.id }}').val();
                    const msgElement = $('h6.form-check-label[for="msg1"]');

                    // Masquer le message par défaut
                    msgElement.addClass('d-none');

                    if (!dateVol) {
                        $('#{{ form.datRetro.vars.id }}').val('');
                        return;
                    }

                    if (retroVol > 0) {
                        const date = new Date(dateVol);
                        if (isNaN(date.getTime())) {
                            console.error('Date vol est invalide');
                            return;
                        }

                        date.setDate(date.getDate() - retroVol);

                        if (isNaN(date.getTime())) {
                            console.error('Date rétro calculée invalide');
                            return;
                        }

                        const year = date.getFullYear();
                        const month = String(date.getMonth() + 1).padStart(2, '0');
                        const day = String(date.getDate()).padStart(2, '0');
                        const formattedDate = `${year}-${month}-${day}`;

                        $('#{{ form.datRetro.vars.id }}').val(formattedDate);

                        // Comparer avec la date du jour
                        const today = new Date();
                        const todayString = today.toISOString().split('T')[0]; // Format YYYY-MM-DD
console.log(today);
                        console.log('Date rétro:', formattedDate, 'Date aujourd\'hui:', todayString);

                        if (formattedDate < todayString) {
                            msgElement.removeClass('d-none'); // Afficher seulement si datretro < datejour
                            console.log('Afficher message: datretro < datejour');
                        } else {
                            msgElement.addClass('d-none'); // Masquer sinon
                            console.log('Masquer message: datretro >= datejour');
                        }

                    } else {
                        $('#{{ form.datRetro.vars.id }}').val(dateVol);
                        // Pas de rétro, donc masquer le message
                        msgElement.addClass('d-none');
                    }
                } catch (error) {
                    console.error('Erreur dans le calcul de la date rétro:', error);
                    $('h6.form-check-label[for="msg1"]').addClass('d-none');
                }
            }

            // Configuration du nettoyage des zéros
            function setupZeroCleanup() {
                $('input.form-control, input.form-control-sm').on('focus', function() {
                    const value = $(this).val().trim();
                    if (value === '0' || value === '0.00' || value === '.00') {
                        $(this).val('');
                    }
                });

                $('input.form-control, input.form-control-sm').on('blur', function() {
                    const value = $(this).val().trim();
                    if (value === '' ) {
                        $(this).val('0');
                    }
                });
            }

            // Gestion des villes par destination
            function setupDestinationVilles() {
                $('.destination_select').on('change', function() {
                    const paysId = $(this).val();

                    if (!paysId) {
                        $('.villed').empty().append('<option value="">Sélectionner une ville</option>');
                        $('.villea').empty().append('<option value="">Sélectionner une ville</option>');
                        return;
                    }

                    $.ajax({
                        url: '/ville/villes-by-pays/' + paysId,
                        method: 'GET',
                        dataType: 'json',
                        success: function(data) {
                            console.log('Données reçues:', data);
                            updateSelect('.villed', data.villesDepart, 'Sélectionner une ville de départ');
                            updateSelect('.villea', data.villesArrivee, 'Sélectionner une ville d\'arrivée');
                        },
                        error: function(xhr, status, error) {
                            console.error('Erreur AJAX:', error);
                            console.log('Réponse serveur:', xhr.responseText);
                            alert('Erreur lors du chargement des villes');
                        }
                    });
                });

                function updateSelect(selectClass, villes, placeholder) {
                    const $select = $(selectClass);
                    const currentValue = $select.val();

                    $select.empty();
                    $select.append($('<option>', {
                        value: '',
                        text: placeholder,
                        disabled: true,
                        selected: true
                    }));

                    $.each(villes, function(index, ville) {
                        const $option = $('<option>', {
                            value: ville.id,
                            text: ville.libelle
                        });

                        if (ville.aero) {
                            $option.attr('data-aero', ville.aero);
                        }

                        $select.append($option);
                    });

                    if (currentValue && $select.find('option[value="' + currentValue + '"]').length > 0) {
                        $select.val(currentValue);
                    }

                    $select.trigger('change');
                }
            }

            // Initialisation
            function init() {
                setupVilleSelect('.ville-select', 'aeroarr', '/vol/get-aeroport/');
                setupVilleSelect('.ville-select-depart', 'aerodep', '/vol/get-aeroport/');
                setupAffretSelect();
                setupDestinationVilles();
                setupZeroCleanup();
                setupValidationCleanup();
                setupDateSynchronization();
                $('[data-calc="ouvert"], [data-calc="vendu"],[data-calc="reserve"]').on('input', calculateDispo);
                calculateDispo();
                showStep(0);

                // Calcul JO depuis datevol
                const $dateField = $('#{{ form.datevol.vars.id }}');
                const $joField   = $('#{{ form.jo.vars.id }}');

                $dateField.on('change', function(){
                    const v = $(this).val();
                    if(v){
                        const [y,m,d] = v.split('-').map(Number);
                        const dt = new Date(y, m-1, d);
                        let jo = dt.getDay();
                        if(jo===0) jo = 7; // Dimanche = 7
                        $joField.val(jo);
                    } else {
                        $joField.val('');
                    }
                });

                if($dateField.val()) {
                    $dateField.trigger('change');
                }

                calculateDateRetro();
            }

            // Lancement de l'initialisation
            init();
        });

        // Gestion des dates
        document.addEventListener('DOMContentLoaded', function() {
            const dateStart = document.querySelector('.date-start');
            const dateEnd = document.querySelector('.date-end');
            const dayOfWeek = document.querySelector('.day-of-week');

            // Synchronisation des dates
            if (dateStart && dateEnd) {
                dateStart.addEventListener('change', function() {
                    dateEnd.min = this.value;
                    if (dateEnd.value && dateEnd.value < this.value) {
                        dateEnd.value = this.value;
                    }
                });
            }

            // Calcul du jour de la semaine
            if (dateStart && dayOfWeek) {
                dateStart.addEventListener('change', function() {
                    if (this.value) {
                        const date = new Date(this.value);
                        const day = date.getDay();
                        const phpDay = day === 0 ? 7 : day;
                        dayOfWeek.value = phpDay;
                    }
                });
            }
        });
        function calculateDateRetro() {
            try {
                const retroVol = parseInt($('#{{ form.retro_vol.vars.id }}').val()) || 0;
                const dateVol = $('#{{ form.datevol.vars.id }}').val();
                const msgElement = $('h6.form-check-label[for="msg1"]');

                // Masquer le message par défaut
                msgElement.addClass('d-none');

                if (!dateVol) {
                    $('#{{ form.datRetro.vars.id }}').val('');
                    return;
                }

                if (retroVol > 0) {
                    const date = new Date(dateVol);
                    if (isNaN(date.getTime())) {
                        console.error('Date vol est invalide');
                        return;
                    }

                    date.setDate(date.getDate() - retroVol);

                    if (isNaN(date.getTime())) {
                        console.error('Date rétro calculée invalide');
                        return;
                    }

                    const year = date.getFullYear();
                    const month = String(date.getMonth() + 1).padStart(2, '0');
                    const day = String(date.getDate()).padStart(2, '0');
                    const formattedDate = `${year}-${month}-${day}`;

                    $('#{{ form.datRetro.vars.id }}').val(formattedDate);

                    // Comparer avec la date du jour
                    const today = new Date();
                    const todayString = today.toISOString().split('T')[0]; // Format YYYY-MM-DD
                    console.log(today);
                    console.log('Date rétro:', formattedDate, 'Date aujourd\'hui:', todayString);

                    if (formattedDate < todayString) {
                        msgElement.removeClass('d-none'); // Afficher seulement si datretro < datejour
                        console.log('Afficher message: datretro < datejour');
                    } else {
                        msgElement.addClass('d-none'); // Masquer sinon
                        console.log('Masquer message: datretro >= datejour');
                    }

                } else {
                    $('#{{ form.datRetro.vars.id }}').val(dateVol);
                    // Pas de rétro, donc masquer le message
                    msgElement.addClass('d-none');
                }
            } catch (error) {
                console.error('Erreur dans le calcul de la date rétro:', error);
                $('h6.form-check-label[for="msg1"]').addClass('d-none');
            }
        }
        // Événements pour le calcul de la date rétro
        $('#{{ form.retro_vol.vars.id }}, #{{ form.datevol.vars.id }}').on('input change', function() {
            calculateDateRetro();
        });
        // Fonction pour supprimer les erreurs de validation quand l'utilisateur saisit
        function setupValidationCleanup() {
            // Écouter les événements de saisie sur tous les champs
            $(document).on('input change', '.form-control, .form-select', function() {
                const $field = $(this);

                // Si le champ a la classe is-invalid et qu'il a maintenant une valeur
                if ($field.hasClass('is-invalid') && $field.val().toString().trim() !== '') {
                    // Supprimer la classe is-invalid
                    $field.removeClass('is-invalid');

                    // Supprimer le message d'erreur associé
                    $field.next('.invalid-feedback').remove();
                }
            });

            // Gestion spécifique pour les champs radio et checkbox
            $(document).on('change', '.form-check-input', function() {
                const $field = $(this);

                if ($field.hasClass('is-invalid') && $field.is(':checked')) {
                    // Supprimer la classe is-invalid de l'input
                    $field.removeClass('is-invalid');

                    // Supprimer la classe is-invalid du label parent si présente
                    $field.closest('.form-check').find('.form-check-label').removeClass('is-invalid');

                    // Supprimer le message d'erreur associé
                    $field.closest('.form-check').next('.invalid-feedback').remove();
                }
            });
        }
        function setupDateSynchronization() {
            const $dateVol = $('#{{ form.datevol.vars.id }}');
            const $dateVolAu = $('#{{ form.datevolau.vars.id }}');
            const $dateConvo = $('#{{ form.dateconvo.vars.id }}');

            $dateVol.on('change', function() {
                const selectedDate = $(this).val();

                if (selectedDate) {
                    // Synchroniser datevolau
                    $dateVolAu.val(selectedDate);

                    // Synchroniser dateconvo
                    $dateConvo.val(selectedDate);

                    // Déclencher les événements pour les calculs dépendants
                    $dateVolAu.trigger('change');
                    $dateConvo.trigger('change');

                    console.log('Dates synchronisées:', selectedDate);
                }
            });

            // Initialisation si une date existe déjà
            if ($dateVol.val()) {
                $dateVolAu.val($dateVol.val());
                $dateConvo.val($dateVol.val());
            }
        }
    </script>
