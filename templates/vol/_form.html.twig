                            <div class="flight-section arrival-section">
                                <span class="section-title fw-bold">[Arrivée]</span>
                                <div class="mb-1">
                                    <div class="form-group-legend">
                                        {{ form_widget(form.villeA, {'attr': {
                                            'class':'form-select form-select-sm ville-select villea',
                                            'id':'villeA',
                                            'data-aero-target':'aeroarr'
                                        }}) }}
                                        {{ form_label(form.villeA, 'Ville d\'arrivée:', {'label_attr': {'class':'form-label'}}) }}
                                        {{ form_errors(form.villeA) }}
                                    </div>
                                    <div class="form-group-legend">
                                        {{ form_widget(form.aeroarr, {'attr': {
                                            'class':'form-control bg-white form-control-sm aeroarr',
                                            'id':'aeroarr',
                                            'readonly':true
                                        }}) }}
                                        {{ form_label(form.aeroarr, 'Aéroport Arrivée:', {'label_attr': {'class':'form-label'}}) }}
                                        {{ form_errors(form.aeroarr) }}
                                    </div>
                                </div>
                                <div class="mb-1">
                                    <div class="form-group-legend">
                                        {{ form_widget(form.heurea, {'attr': {
                                            'class':'form-control bg-white form-control-sm',
                                            'data-aeroport-target':'timeInput'
                                        }}) }}
                                        {{ form_label(form.heurea, "Heure d'arrivée:", {'label_attr': {'class':'form-label'}}) }}
                                        {{ form_errors(form.heurea) }}
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Via -->
                        <div class="col-md-4">
                            <div class="flight-section via-section">
                                <span class="section-title text-warning fw-bold">[Via]</span>
                                <div class="mb-1">
                                    <div class="form-group-legend">
                                        {{ form_widget(form.villeV, {'attr': {'class':'form-select form-select-sm'}}) }}
                                        {{ form_label(form.villeV, 'Ville Via:', {'label_attr': {'class':'form-label'}}) }}
                                        {{ form_errors(form.villeV) }}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Options de vol -->
