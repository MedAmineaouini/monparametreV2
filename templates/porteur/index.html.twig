{% extends 'base2.html.twig' %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block title %}RFT | Listes des Porteurs{% endblock %}

{% block body %}
    <div class="card shadow rounded-3 border-0">
        <div class="card-header text-white d-block d-sm-flex justify-content-between align-items-center">
            <h5 class="mb-0 ">📋 Liste des Apporteurs</h5>
            <div class="d-flex ">
{#            <button type="button" class="btn btn-success btn-sm-12" data-bs-toggle="modal" data-bs-target="#modalCenter">#}
{#                <i class="bx bx-plus"></i> Nouveau Apporteur#}
{#            </button>#}
                <button class="btn btn-success w-100 w-sm-auto" data-bs-toggle="modal" data-bs-target="#modalCenter"><i class="bx bx-plus"></i> Nouveau Apporteur</button>
            </div>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table  class="table table-bordered table-striped align-middle small">
                    <thead>
                        <th>#</th>
                        <th style="width: 75%">Libellé</th>
                        <th>Actions</th>
                    </thead>
                    <tbody>
                    {% if porteurs is not empty %}
                        {% for porteur in porteurs %}
                            <tr>
                                <td>{{ porteur.seqPorteur }}</td>
                                <td>{{ porteur.libPorteur }}</td>
                                <td>
                                    <div class="dropdown">
                                        <button type="button" class="btn p-0 dropdown-toggle hide-arrow"
                                                data-bs-toggle="dropdown">
                                            <i class="icon-base bx bx-dots-vertical-rounded"></i>
                                        </button>
                                        <div class="dropdown-menu">
                                            <a class="dropdown-item" href="#"
                                               data-bs-toggle="modal"
                                               data-bs-target="#editModal"
                                               data-url="{{ path('app_porteur_edit', {'seqPorteur': porteur.seqPorteur}) }}">
                                                <i class="icon-base bx bx-edit-alt me-1"></i> Modifier
                                            </a>
                                            {{ include('porteur/_delete_form.html.twig', { 'porteur': porteur }) }}
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td colspan="3" class="text-center text-muted">
                                Aucun enregistrement trouvé.
                            </td>
                        </tr>
                    {% endif %}
                    </tbody>
                </table>
            </div>

        </div>
    </div>

    <!-- Modal: Nouveau Porteur -->
    <div class="modal fade" id="modalCenter" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Nouveau Apporteur</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>

                {{ form_start(form, {'attr': {'class': 'browser-default-validation'}}) }}
                    <div class="modal-body">
                        <div class="mb-3">
                            {{ form_label(form.libPorteur, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            <strong class="text-danger">*</strong>
                            {{ form_widget(form.libPorteur, {
                                'attr': {
                                    'class': 'form-control',
                                    'maxlength': 50,
                                    'placeholder': 'Libellé du apporteur',
                                    'required': 'required'
                                }
                            }) }}
                        </div>
                        {#<div class="mb-3">
                            {{ form_label(form.codeComm, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.codeComm, {
                                'attr': {
                                    'class': 'form-control',
                                    'maxlength': 20,
                                    'placeholder': 'Code commercial'
                                }
                            }) }}
                        </div>#}
                    </div>

            <div class="pt-3 border-top text-end">
                <button type="submit" class="btn btn-primary w-100 mb-2">
                    <i class="bx bx-save me-2"></i>{{ button_label|default('Enregistrer') }}
                </button>
                {% if form.vars.data.porteur %}
                    <a href="{{ path('app_porteur_index') }}" class="btn btn-outline-danger w-100 px-4">
                        <i class="bx bx-x me-2"></i>Annuler
                    </a>
                {% else %}
                    <button type="button" class="btn btn-outline-danger w-100 px-4" data-bs-dismiss="offcanvas">
                        <i class="bx bx-x me-2"></i>Annuler
                    </button>
                {% endif %}
            </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>

    <!-- Modal: Edit Porteur -->
    <div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Modifier Apporteur</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body" id="editModalContent">
                    <!-- Content will be loaded here via AJAX -->
                </div>
            </div>
        </div>
    </div>
{% endblock %}

