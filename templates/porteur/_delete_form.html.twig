<form method="post" 
      action="{{ path('app_porteur_delete', {'seqPorteur': porteur.seqPorteur}) }}" 
      class="delete-form d-inline">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ porteur.seqPorteur) }}">
    <button type="button" 
            class="dropdown-item text-danger border-0 bg-transparent w-100 text-start delete-btn"
            data-confirm-message="Êtes-vous sûr de vouloir supprimer cet apporteur ?"
            data-success-message="L'apporteur a été supprimé avec succès">
        <i class="icon-base bx bx-trash me-1"></i> Supprimer
    </button>
</form>