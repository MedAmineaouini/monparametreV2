<div class="card-body p-1" style="font-size: 12px">
    {{ form_start(form, {'attr': {'class': 'browser-default-validation'}}) }}

    <div class="row g-3 mb-4 align-items-center">
        <div class="col-md-6">
            {{ form_label(form.libPorteur, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
            <strong class="text-danger">*</strong>
            {{ form_widget(form.libPorteur, {
                'attr': {
                    'class': 'form-control',
                    'maxlength': 50,
                    'placeholder': 'Libellé du apporteur',
                    'required': 'required'
                }
            }) }}
        </div>

        <div class="col-md-6">
            {{ form_label(form.codeComm, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
            {{ form_widget(form.codeComm, {
                'attr': {
                    'class': 'form-control',
                    'maxlength': 20,
                    'placeholder': 'Code commercial'
                }
            }) }}
        </div>
    </div>

    {# Ajoutez d'autres champs si nécessaire #}
    {# <div class="row g-3 mb-4 align-items-center">
        <div class="col-md-6">
            {{ form_label(form.autreChamp, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
            {{ form_widget(form.autreChamp, {'attr': {'class': 'form-control'}}) }}
        </div>
    </div> #}

    <div class="pt-3 border-top text-end">
        <button type="submit" class="btn btn-primary px-4">
            <i class="bx bx-save me-2"></i>{{ button_label|default('Enregistrer') }}
        </button>
        <a href="{{ path('app_porteur_index') }}" class="btn btn-outline-secondary px-4">
            <i class="bx bx-x me-2"></i>Annuler
        </a>
    </div>

    {{ form_end(form) }}
</div>