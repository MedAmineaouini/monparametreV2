{% extends 'base.html.twig' %}

{% block title %}RFT | Listes des assurances{% endblock %}

{% block body %}
<div class="card shadow rounded-3 border-0">
    <div class="card-header  text-white">
        <div class="row align-items-center">
            <div class="col-12 col-md-6 mb-2 mb-md-0">
                <h5 class="mb-0 text-center text-md-start">📋 Liste des assurances</h5>
            </div>
            <div class="col-12 col-md-6 d-flex flex-column flex-md-row justify-content-md-end gap-2">
                <a href="{{ path('app_assur_new') }}" class="btn btn-success w-100 w-md-auto">
                    <i class="bx bx-plus"></i> Nouvelle assurance
                </a>
                <a href="{{ path('app_assur_export_pdf') }}" class="btn btn-danger w-100 w-md-auto" target="_blank">
                    <i class="bx bxs-file-pdf"></i> Exporter en PDF
                </a>
            </div>
        </div>
    </div>

    <div class="card-body p-1">
        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle small w-100">
                <thead>
                <tr>
                    <th>#</th>
                    <th>Assurance</th>
                    <th>Mini</th>
                    <th>Maxi</th>
                    <th>Montant</th>
                    <th>Achat</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                {% for assur in assurs %}
                    <tr>
                        <td>{{ assur.seqassur }}</td>
                        <td>{{ assur.libassur }}</td>
                        <td class="text-end">{{ '%.2f'|format(assur.mini1) }} &euro;</td>
                        <td class="text-end">{{ '%.2f'|format(assur.maxi1) }} &euro;</td>
                        <td class="text-end">{{ '%.2f'|format(assur.valeur) }} &euro;</td>
                        <td class="text-end">{{ '%.2f'|format(assur.valeurAchat) }} &euro;</td>
                        <td>
                            <div class="dropdown">
                                <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                                    <i class="icon-base bx bx-dots-vertical-rounded"></i>
                                </button>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item" href="{{ path('app_assur_edit', {'seqassur': assur.seqassur}) }}">
                                        <i class="icon-base bx bx-edit-alt me-1"></i> Consulter / Modifier
                                    </a>
                                    {{ include('assur/_delete_form.html.twig') }}
                                </div>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center text-muted">aucun enregistrement trouvé.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>

    {% endblock %}
