<form method="post"
      action="{{ path('app_assur_delete', {'seqassur': assur.seqassur}) }}"
      class="assur-delete-form"
      data-confirm="Êtes-vous sûr de vouloir supprimer cet Assurance ?"
      style="display: inline;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ assur.seqassur) }}">
    <button type="submit" class="dropdown-item text-danger border-0 bg-transparent w-100 text-start">
        <i class="icon-base bx bx-trash me-1"></i> Supprimer
    </button>
</form>