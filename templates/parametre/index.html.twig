{% extends 'base.html.twig' %}

{% block title %}Parametre{% endblock %}

{% block content %}
<div class="container-xxl flex-grow-1 container-p-y">
    <h1>Parametre</h1>

                <div class="card">
                <h5 class="card-header pb-0 text-md-start text-center"> Parametre index </h5>
                <div class="card-datatable text-nowrap p-5">
                  <table class="dt-column-search table table-bordered table-responsive">
                    <thead>
                      <tr>
                        <th>Entete1</th>
                        <th>Entete2</th>
                        <th>Adresse</th>
                        <th>Cp</th>
                        <th>Ville</th>
                        <th>Pays</th>
                        <th>Tel</th>
                        <th>Fax</th>
                        <th>actions</th>
                      </tr>
                    </thead>
                    <tfoot>
                      {% for parametre in parametres %}
                     <tr>
                        <td>{{ parametre.entete1 }}</td>
                        <td>{{ parametre.entete2 }}</td>
                        <td>{{ parametre.adresse }}</td>
                        <td>{{ parametre.cp }}</td>
                        <td>{{ parametre.ville }}</td>
                        <td>{{ parametre.pays }}</td>
                        <td>{{ parametre.tel }}</td>
                        <td>{{ parametre.fax }}</td>

                        <td>
                        <a class="btn btn-sm btn-outline-primary" href="{{ path('app_parametre_show', {'seqparam': parametre.seqparam}) }}">Détail</a>
                        <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_parametre_edit', {'seqparam': parametre.seqparam}) }}">Modifier</a>
                        </td>
                        </tr>
                        {% else %}
                            <tr>
                                <td colspan="8" class="text-center">No records found</td>
                            </tr>
                        {% endfor %}
                    </tfoot>
                  </table>
                </div>
              </div>

    <a href="{{ path('app_parametre_new') }}" class="btn btn-success mt-3">Créer un nouveau parametre </a>
</div>
{% endblock %}