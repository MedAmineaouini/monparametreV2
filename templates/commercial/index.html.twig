{% extends 'base2.html.twig' %}

{% block title %}Liste des commerciaux{% endblock %}

{% block body %}
  <div class="container-xxl flex-grow-1 container-p-y">
    <div class="card">
      <div class="card-header border-bottom">
        <h5 class="card-title mb-0">Liste des commerciaux</h5>
        <div class="d-flex justify-content-between align-items-center row pt-4 gap-md-0 g-6">
          <div class="col-md-4">
            <button class="btn btn-primary" data-bs-toggle="offcanvas" data-bs-target="#offcanvasAddCommercial">
              <i class="icon-base bx bx-plus me-2"></i>Ajouter un commercial
            </button>
          </div>
        </div>
      </div>
      <div class="card-datatable">
        <table class="datatables-commercials table border-top">
          <thead>
            <tr>
              <th>ID</th>
              <th>Code</th>
              <th>Nom</th>
              <th>Prénom</th>
              <th>Téléphone</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {% for commercial in commercials %}
              <tr>
                <td>{{ commercial.seqCommercial }}</td>
                <td>{{ commercial.codeCommercial }}</td>
                <td>{{ commercial.nomCommercial }}</td>
                <td>{{ commercial.prenomCommercial }}</td>
                <td>{{ commercial.telCommercial }}</td>
                <td>
                  <div class="d-flex">
                    <a href="{{ path('app_commercial_show', {'seqCommercial': commercial.seqCommercial}) }}" 
                       class="btn btn-sm btn-icon me-2" title="Voir">
                      <i class="icon-base bx bx-show"></i>
                    </a>
                    <a href="{{ path('app_commercial_edit', {'seqCommercial': commercial.seqCommercial}) }}" 
                       class="btn btn-sm btn-icon me-2" title="Modifier">
                      <i class="icon-base bx bx-edit"></i>
                    </a>
                    <form method="post" action="{{ path('app_commercial_delete', {'seqCommercial': commercial.seqCommercial}) }}" 
                          onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce commercial ?');">
                      <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ commercial.seqCommercial) }}">
                      <button type="submit" class="btn btn-sm btn-icon" title="Supprimer">
                        <i class="icon-base bx bx-trash"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            {% else %}
              <tr>
                <td colspan="6" class="text-center">Aucun commercial trouvé</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Offcanvas pour ajouter un nouveau commercial -->
  <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasAddCommercial" aria-labelledby="offcanvasAddCommercialLabel">
    <div class="offcanvas-header border-bottom">
      <h5 id="offcanvasAddCommercialLabel" class="offcanvas-title">Ajouter un commercial</h5>
      <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body mx-0 flex-grow-0 p-6 h-100">
      {{ form_start(form, {'attr': {'class': 'add-new-commercial pt-0', 'id': 'addNewCommercialForm'}}) }}
        <div class="mb-3">
          {{ form_label(form.codeCommercial, 'Code commercial', {'label_attr': {'class': 'form-label'}}) }}
          {{ form_widget(form.codeCommercial, {'attr': {'class': 'form-control', 'placeholder': 'CODE'}}) }}
        </div>
        <div class="mb-3">
          {{ form_label(form.nomCommercial, 'Nom', {'label_attr': {'class': 'form-label'}}) }}
          {{ form_widget(form.nomCommercial, {'attr': {'class': 'form-control', 'placeholder': 'Nom du commercial'}}) }}
        </div>
        <div class="mb-3">
          {{ form_label(form.prenomCommercial, 'Prénom', {'label_attr': {'class': 'form-label'}}) }}
          {{ form_widget(form.prenomCommercial, {'attr': {'class': 'form-control', 'placeholder': 'Prénom du commercial'}}) }}
        </div>
        <div class="mb-3">
          {{ form_label(form.telCommercial, 'Téléphone', {'label_attr': {'class': 'form-label'}}) }}
          {{ form_widget(form.telCommercial, {'attr': {'class': 'form-control', 'placeholder': 'Numéro de téléphone'}}) }}
        </div>
        <button type="submit" class="btn btn-primary me-3">Enregistrer</button>
        <button type="reset" class="btn btn-label-danger" data-bs-dismiss="offcanvas">Annuler</button>
      {{ form_end(form) }}
    </div>
  </div>
{% endblock %}

