{% extends 'base.html.twig' %}

{% block title %}RFT | Liste des commerciaux{% endblock %}

{% block body %}
<div class="card shadow rounded-3 border-0">
  <div class="card-header text-white">
    <div class="row align-items-center">
      <div class="col-12 col-md-8 mb-2 mb-md-0">
        <h5 class="mb-0 text-center text-md-start">📋 Liste des commerciaux</h5>
      </div>
      <div class="col-9 col-md-4 d-flex flex-column flex-md-row justify-content-md-end gap-2">
        <a class="btn btn-success w-100 w-md-auto" data-bs-toggle="offcanvas" data-bs-target="#offcanvasAddCommercial">
          <i class="bx bx-plus me-2"></i>Ajouter un commercial
        </a>
      </div>
    </div>
  </div>

  <div class="card-body p-1">
    <div class="table-responsive">
      <table class="table table-hover table-striped table-bordered mb-1">
        <thead>
          <tr>
            <th class="text-center" width="60">#</th>
            <th>Code</th>
            <th>Nom</th>
            <th>Prénom</th>
            <th>Téléphone</th>
            <th class="text-center" width="100">Actions</th>
          </tr>
        </thead>
        <tbody>
        {% for commercial in commercials %}
          <tr>
            <td class="text-center">{{ commercial.seqCommercial }}</td>
            <td>{{ commercial.codeCommercial }}</td>
            <td>{{ commercial.nomCommercial }}</td>
            <td>{{ commercial.prenomCommercial }}</td>
            <td>{{ commercial.telCommercial }}</td>
            <td class="text-center">
              <div class="dropdown">
                <button class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown" aria-expanded="false">
                  <i class="bx bx-dots-vertical-rounded"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                  <li>
                    <a class="dropdown-item"
                       href="{{ path('app_commercial_index', {'edit': commercial.seqCommercial}) }}">
                      <i class="bx bx-edit-alt me-2"></i>Consulter | Modifier
                    </a>
                  </li>
                  <li>
                    {{ include('commercial/_delete_form.html.twig', {
                      'commercial': commercial,
                      'btn_class': 'dropdown-item'
                    }) }}
                  </li>
                </ul>
              </div>
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="6" class="text-center py-4 text-muted">
              Aucun commercial enregistré
            </td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Offcanvas Ajouter Commercial -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasAddCommercial" aria-labelledby="offcanvasAddCommercialLabel" data-bs-backdrop="static" data-bs-keyboard="false">
  <div class="offcanvas-header border-bottom">
    <h5 id="offcanvasAddCommercialLabel" class="offcanvas-title">Ajouter un commercial</h5>
    <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Fermer"></button>
  </div>
  <div class="offcanvas-body p-6 h-100">
    {{ include('commercial/_form.html.twig', {
      form: addForm,
      button_label: 'Enregistrer'
    }) }}
  </div>
</div>

<!-- Offcanvas Modifier Commercial -->
{% if editForm is defined and editForm %}
  <div class="offcanvas offcanvas-end show" tabindex="-1" id="offcanvasEditCommercial" style="visibility: visible;" data-bs-backdrop="static" data-bs-keyboard="false" aria-labelledby="offcanvasEditCommercialLabel">
    <div class="offcanvas-header border-bottom">
      <h5 id="offcanvasEditCommercialLabel" class="offcanvas-title">Modifier le commercial</h5>
      <a href="{{ path('app_commercial_index') }}" class="btn-close text-reset" aria-label="Fermer"></a>
    </div>
    <div class="offcanvas-body p-6 h-100">
      {{ include('commercial/_form.html.twig', {
        form: editForm,
        button_label: 'Mettre à jour'
      }) }}
    </div>
  </div>

  <script>
    // Fermer offcanvas ajout si on édite
    const addOffcanvas = document.getElementById('offcanvasAddCommercial');
    if (addOffcanvas) {
      const bsAddOffcanvas = bootstrap.Offcanvas.getInstance(addOffcanvas);
      if (bsAddOffcanvas) {
        bsAddOffcanvas.hide();
      }
    }
  </script>
{% endif %}
{% endblock %}
