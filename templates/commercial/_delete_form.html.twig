<form method="post" 
      action="{{ path('app_commercial_delete', {'seqCommercial': commercial.seqCommercial}) }}" 
      onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce commercial ?');"
      class="d-inline">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ commercial.seqCommercial) }}">
    <button type="submit" class="dropdown-item text-danger border-0 bg-transparent w-100 text-start">
        <i class="icon-base bx bx-trash me-1"></i> Supprimer
    </button>
</form>
