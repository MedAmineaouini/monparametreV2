<div class="card-body p-1" style="font-size: 12px">
    {{ form_start(form, {'attr': {'class': 'browser-default-validation'}}) }}

    <div class="mb-3">
        {{ form_label(form.codeCommercial, 'Code commercial', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.codeCommercial, {'attr': {'class': 'form-control', 'placeholder': 'CODE'}}) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.nomCommercial, 'Nom', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.nomCommercial, {'attr': {'class': 'form-control', 'placeholder': 'Nom du commercial'}}) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.prenomCommercial, 'Prénom', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.prenomCommercial, {'attr': {'class': 'form-control', 'placeholder': 'Prénom'}}) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.telCommercial, 'Téléphone', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.telCommercial, {'attr': {'class': 'form-control', 'placeholder': 'Téléphone'}}) }}
    </div>

    <div class="pt-3 border-top text-end">
        <button type="submit" class="btn btn-primary w-100 mb-2">
            <i class="bx bx-save me-2"></i>{{ button_label|default('Enregistrer') }}
        </button>

        {% if form.vars.data.seqCommercial is defined and form.vars.data.seqCommercial %}
            <a href="{{ path('app_commercial_index') }}" class="btn btn-outline-danger w-100 px-4">
                <i class="bx bx-x me-2"></i>Annuler
            </a>
        {% else %}
            <button type="button" class="btn btn-outline-danger w-100 px-4" data-bs-dismiss="offcanvas">
                <i class="bx bx-x me-2"></i>Annuler
            </button>
        {% endif %}
    </div>

    {{ form_end(form) }}
</div>
