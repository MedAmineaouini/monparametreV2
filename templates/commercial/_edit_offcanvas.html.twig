{% extends 'base2.html.twig' %}

{% block title %}Modifier un commercial{% endblock %}

{% block body %}
<div class="container mt-5">
  <h3>Modifier le commercial</h3>

  {{ form_start(editForm) }}
    <div class="mb-3">
      {{ form_label(editForm.codeCommercial) }}
      {{ form_widget(editForm.codeCommercial, {'attr': {'class': 'form-control'}}) }}
    </div>
    <div class="mb-3">
      {{ form_label(editForm.nomCommercial) }}
      {{ form_widget(editForm.nomCommercial, {'attr': {'class': 'form-control'}}) }}
    </div>
    <div class="mb-3">
      {{ form_label(editForm.prenomCommercial) }}
      {{ form_widget(editForm.prenomCommercial, {'attr': {'class': 'form-control'}}) }}
    </div>
    <div class="mb-3">
      {{ form_label(editForm.telCommercial) }}
      {{ form_widget(editForm.telCommercial, {'attr': {'class': 'form-control'}}) }}
    </div>

    <div class="d-flex justify-content-between">
      <button type="submit" class="btn btn-primary w-25">Enregistrer</button>
      <a href="{{ path('app_commercial_index') }}" class="btn btn-label-danger w-25">Annuler</a>
    </div>
  {{ form_end(editForm) }}
</div>
{% endblock %}
